                            <ChildContent>
                                <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject.RoundingAccountId" />
                            </ChildContent>
                        </VanigamAccountingFormField>

                        <VanigamAccountingFormField Text=@Localizer["ExchangeGainLoss"]>
                            <ChildContent>
                                <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject.ExchangeGainLossAccountId" />
                            </ChildContent>
                        </VanigamAccountingFormField>

                        <VanigamAccountingFormField Text=@Localizer["FreightCharges"]>
                            <ChildContent>
                                <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject.FreightChargesAccountId" />
                            </ChildContent>
                        </VanigamAccountingFormField>

                        <VanigamAccountingFormField Text=@Localizer["PackingCharges"]>
                            <ChildContent>
                                <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject.PackingChargesAccountId" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                    </RadzenStack>
                </RadzenTabsItem>

                @* Configuration Tab *@
                <RadzenTabsItem Text="@Localizer["Configuration"]" Icon="@FadIcon("fa-cog")" class="fa-small">
                    <RadzenStack Gap="1rem" class="rz-p-4">
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.IsActive Name="chk_IsActive" />
                            <RadzenLabel Text=@Localizer["IsActive"] Component="chk_IsActive" class="rz-ms-2" />
                        </div>

                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2 rz-mt-4">@Localizer["AutoPostingOptions"]</RadzenText>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.AutoPostInvoices Name="chk_AutoPostInvoices" />
                            <RadzenLabel Text=@Localizer["AutoPostInvoices"] Component="chk_AutoPostInvoices" class="rz-ms-2" />
                        </div>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.AutoPostPayments Name="chk_AutoPostPayments" />
                            <RadzenLabel Text=@Localizer["AutoPostPayments"] Component="chk_AutoPostPayments" class="rz-ms-2" />
                        </div>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.AutoPostPurchaseInvoices Name="chk_AutoPostPurchaseInvoices" />
                            <RadzenLabel Text=@Localizer["AutoPostPurchaseInvoices"] Component="chk_AutoPostPurchaseInvoices" class="rz-ms-2" />
                        </div>

                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2 rz-mt-4">@Localizer["AccountingOptions"]</RadzenText>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.UseJobCosting Name="chk_UseJobCosting" />
                            <RadzenLabel Text=@Localizer["UseJobCosting"] Component="chk_UseJobCosting" class="rz-ms-2" />
                        </div>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.UseInventoryAccounting Name="chk_UseInventoryAccounting" />
                            <RadzenLabel Text=@Localizer["UseInventoryAccounting"] Component="chk_UseInventoryAccounting" class="rz-ms-2" />
                        </div>
                        <div class="rz-p-1 rz-text-align-left">
                            <RadzenCheckBox @bind-Value=@CurrentObject.EnableMultiCurrency Name="chk_EnableMultiCurrency" />
                            <RadzenLabel Text=@Localizer["EnableMultiCurrency"] Component="chk_EnableMultiCurrency" class="rz-ms-2" />
                        </div>

                        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2 rz-mt-4">@Localizer["GeneralSettings"]</RadzenText>

                        <VanigamAccountingFormField Text=@Localizer["FiscalYearStartMonth"]>
                            <ChildContent>
                                <RadzenNumeric @bind-Value="@FiscalMonthNumeric" Min="1" Max="12" Name="num_FiscalMonth" class="w-100" />
                            </ChildContent>
                        </VanigamAccountingFormField>

                        <VanigamAccountingFormField Text=@Localizer["DefaultCurrency"]>
                            <ChildContent>
                                <VanigamAccountingTextBox @bind-Value="@CurrentObject.DefaultCurrency" Name="txt_Currency" />
                            </ChildContent>
                        </VanigamAccountingFormField>

                        <VanigamAccountingFormField Text=@Localizer["Notes"]>
                            <ChildContent>
                                <RadzenTextArea @bind-Value="@CurrentObject.Notes" Name="txt_Notes" Rows="3" class="w-100" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                    </RadzenStack>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
            <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>
