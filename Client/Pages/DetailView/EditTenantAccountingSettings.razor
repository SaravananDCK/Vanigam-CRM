                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.DefaultInventoryAccount?.Name ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
