@page "/edit-invoice"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Objects.DTOs
@using Vanigam.CRM.Client.Validators
@using Vanigam.CRM.Client.Pages.ListView
@using Vanigam.CRM.Client.Components
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Invoice, EditInvoice>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditInvoice"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]" />
        }
    </CustomBadge>
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                @* Invoice Information Display *@
                <div class="read-only-section-header">@Localizer["InvoiceInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Customer"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Party?.Name ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Number"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Number ?? "-")</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Status.ToString())</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                @* Invoice Items Display *@
                @if (invoiceItems != null && invoiceItems.Any())
                {
                    <div class="read-only-section-header rz-mt-4">@Localizer["Items"]</div>
                    <RadzenDataGrid AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="10" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                                    Data="@invoiceItems" TItem="InvoiceItemDTO" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" class="rz-mt-3">
                        <Columns>
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="InventoryItemName" Title="@Localizer["Item"]" Width="300px" />
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="Quantity" Title="@Localizer["Quantity"]" Width="100px">
                                <Template Context="item">
                                    @item.Quantity.ToString("N2")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="UnitPrice" Title="@Localizer["UnitPrice"]" Width="120px">
                                <Template Context="item">
                                    @item.UnitPrice.ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="DiscountAmount" Title="@Localizer["Discount"]" Width="120px">
                                <Template Context="item">
                                    @(item.DiscountAmount.ToString("C"))
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="TaxAmount" Title="@Localizer["Tax"]" Width="120px">
                                <Template Context="item">
                                    @((item.TaxAmount ?? 0).ToString("C"))
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="LineTotal" Title="@Localizer["LineTotal"]" Width="120px">
                                <Template Context="item">
                                    @item.Total.ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @* Invoice Summary Totals *@
                    <RadzenRow class="rz-mt-4">
                        <RadzenColumn Size="12" SizeMD="8"></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCard Variant="Variant.Outlined">
                                <RadzenStack Gap="0.5rem">
                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["SubTotal"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.SubTotal.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["DiscountAmount"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.DiscountAmount.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["TaxAmount"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.TaxAmount.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <hr style="border: 1px solid #ccc; margin: 5px 0;" />
                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["TotalAmount"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="field-value">
                                            <strong>@CurrentObject.TotalAmount.ToString("C")</strong>
                                        </RadzenText>
                                    </div>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    @if (CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))
    {
        <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Invoice" Data="@CurrentObject" Visible="@(CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))" Submit="@SaveBulkInvoice">
            <RadzenStack>
                <FluentValidationValidator Validator="new InvoiceValidator(Localizer)" />
                <ValidationSummary />

                @* Invoice Information Section *@
                <RadzenCard class="rz-mb-4">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@Localizer["InvoiceInformation"]</RadzenText>
                    <RadzenStack>
                        <VanigamAccountingFormField Text=@Localizer["Number"]>
                            <ChildContent>
                                @if (string.IsNullOrEmpty(CurrentObject.Number))
                                {
                                    <RadzenText TextStyle="TextStyle.Button" Text="New Invoice" class="rz-m-2" Style="color: var(--rz-success);" />
                                }
                                else
                                {
                                    <RadzenText Text="@CurrentObject.Number" class="rz-m-2" />
                                }
                                @*<VanigamAccountingTextBox @bind-Value="@CurrentObject.Number" Name="txt_Number" ReadOnly="true" />*@
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["Customer"]>
                            <ChildContent>
                                <CustomerDropDownDataGrid @bind-Value="@CurrentObject.PartyId" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["Status"]>
                            <ChildContent>
                                <InvoiceStatusEnumDropDown @bind-Value="@CurrentObject.Status" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenTemplateForm>
        @* Invoice Items Section *@
        <RadzenCard class="rz-mb-4">
            <EditableInvoiceItems Items="@invoiceItems"
                                  ItemsChanged="@OnInvoiceItemsChanged"
                                  TotalAmountChanged="@OnTotalAmountChanged"
                                  TotalTaxChanged="@OnTotalTaxAmountChanged"
                                  DiscountChanged="@OnDiscountAmountChanged"
                                  DiscountPercentageChanged="@OnDiscountPercentageChanged"
                                  SubTotalChanged="@OnSubTotalChanged"
                                  DiscountTypeChanged="@OnDiscountTypeChanged"
                                  Invoice="@CurrentObject" />
        </RadzenCard>

        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!HasAnyChanges)" @bind-IsBusy="IsBusy" Click="@SaveBulkInvoice" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!HasAnyChanges)" @bind-IsBusy="IsBusy" Click="@SaveBulkInvoice" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyModeAsync" />
            }
        </RadzenStack>
    }
</RadzenColumn>