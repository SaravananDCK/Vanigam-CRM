@page "/edit-purchaseinvoice"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Objects.DTOs
@using Vanigam.CRM.Client.Validators
@using Vanigam.CRM.Client.Components
@inherits Vanigam.CRM.Client.Components.BaseDetailView<PurchaseInvoice, EditPurchaseInvoice>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditPurchaseInvoice"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["NumberMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (IsReadOnlyModeVisible)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                <div class="read-only-section-header">@Localizer["PurchaseInvoiceInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Number"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Number ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["VendorInvoiceNumber"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.VendorInvoiceNumber ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Date"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.VoucherDate.ToString("yyyy-MM-dd"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["DueDate"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.DueDate?.ToString("yyyy-MM-dd") ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Vendor"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Party?.Name ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Status.ToString())</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SubTotal"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.SubTotal.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["DiscountAmount"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.DiscountAmount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxAmount"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.TaxAmount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["CGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.CGSTAmount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.SGSTAmount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.IGSTAmount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TotalAmount"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.TotalAmount.ToString("C2"))</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
                @if (!string.IsNullOrEmpty(CurrentObject.Notes))
                {
                    <div class="rz-p-4">
                        <div class="read-only-field">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Notes"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@CurrentObject.Notes</RadzenText>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(CurrentObject.Terms))
                {
                    <div class="rz-p-4">
                        <div class="read-only-field">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Terms"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@CurrentObject.Terms</RadzenText>
                        </div>
                    </div>
                }

                @* Purchase Invoice Items Read-Only Display *@
                @if (purchaseInvoiceItems != null && purchaseInvoiceItems.Any(i => !i.IsDeleted))
                {
                    <div class="rz-p-4">
                        <div class="read-only-section-header rz-mb-3">@Localizer["Items"]</div>
                        <RadzenDataGrid Data="@purchaseInvoiceItems.Where(i => !i.IsDeleted)" TItem="PurchaseInvoiceItemDTO" AllowPaging="true" PageSize="10">
                            <Columns>
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Property="InventoryItemName" Title=@Localizer["Item"] />
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Property="Quantity" Title=@Localizer["Quantity"] FormatString="{0:N2}" />
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Property="UnitPrice" Title=@Localizer["UnitPrice"] FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Property="DiscountAmount" Title=@Localizer["Discount"] FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Property="TaxAmount" Title=@Localizer["Tax"] FormatString="{0:C2}" />
                                <RadzenDataGridColumn TItem="PurchaseInvoiceItemDTO" Title=@Localizer["Total"]>
                                    <Template Context="item">
                                        @((item.Total - item.DiscountAmount + (item.TaxAmount ?? 0)).ToString("C2"))
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="PurchaseInvoice" Data="@CurrentObject" Visible="@IsFormVisible" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new PurchaseInvoiceValidator(Localizer)" />
            <ValidationSummary />

            @* Header Information *@
            <RadzenRow>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["Number"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.Number" Name="txt_Number" ReadOnly="true" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["VendorInvoiceNumber"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.VendorInvoiceNumber" Name="txt_VendorInvoiceNumber" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Date"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.VoucherDate" Name="dt_VoucherDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["DueDate"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.DueDate" Name="dt_DueDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["Vendor"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.PartyId" Data="@Vendors" TextProperty="Name" ValueProperty="Oid" Name="dd_Vendor" class="w-100" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["PurchaseOrder"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.PurchaseOrderId" Data="@PurchaseOrders" TextProperty="Number" ValueProperty="Oid" Name="dd_PurchaseOrder" class="w-100" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Status"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.Status" Data="@(Enum.GetValues(typeof(PurchaseInvoiceStatus)))" Name="dd_Status" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["ReceivedDate"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.ReceivedDate" Name="dt_ReceivedDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                </RadzenColumn>
            </RadzenRow>

            @* Purchase Invoice Items Section *@
            <EditablePurchaseInvoiceItems Items="@purchaseInvoiceItems"
                                          ItemsChanged="@OnPurchaseInvoiceItemsChanged"
                                          TotalAmountChanged="@OnTotalAmountChanged"
                                          TotalTaxChanged="@OnTotalTaxAmountChanged"
                                          DiscountChanged="@OnDiscountAmountChanged"
                                          DiscountPercentageChanged="@OnDiscountPercentageChanged"
                                          SubTotalChanged="@OnSubTotalChanged"
                                          DiscountTypeChanged="@OnDiscountTypeChanged"
                                          PurchaseInvoice="@CurrentObject" />

            @* Totals Section (Read-Only, Calculated) *@
            <RadzenCard class="rz-my-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@Localizer["Totals"]</RadzenText>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SubTotal"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.SubTotal.ToString("C2"))</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["DiscountAmount"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.DiscountAmount.ToString("C2"))</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxAmount"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.TaxAmount.ToString("C2"))</RadzenText>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["CGST"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.CGSTAmount.ToString("C2"))</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SGST"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.SGSTAmount.ToString("C2"))</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IGST"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.IGSTAmount.ToString("C2"))</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TotalAmount"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value"><strong>@(CurrentObject.TotalAmount.ToString("C2"))</strong></RadzenText>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>

            @* Additional Fields *@
            <VanigamAccountingFormField Text=@Localizer["Reference"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Reference" Name="txt_Reference" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Notes"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Notes" Name="txt_Notes" Rows="3" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Terms"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Terms" Name="txt_Terms" Rows="3" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>
        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>
