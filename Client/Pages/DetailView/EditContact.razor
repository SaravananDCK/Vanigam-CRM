@page "/edit-contact"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Contact, EditContact>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject CustomerApiService CustomerApiService

@code {
    [Parameter] public Guid? CustomerId { get; set; }
    private IEnumerable<Customer>? Customers { get; set; }
}

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["Edit Contact"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {

            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                @* Contact Information Display *@
                <div class="read-only-section-header">@Localizer["ContactInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Customer"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(Customers?.FirstOrDefault(c => c.Oid == CurrentObject.CustomerId)?.Name ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["FirstName"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.FirstName ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["LastName"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.LastName ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["JobTitle"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.JobTitle ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Department"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Department ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Type"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Type.ToString())</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Status.ToString())</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Email"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Email ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Phone"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Phone ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Mobile"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Mobile ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["LinkedInProfile"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.LinkedInProfile ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IsPrimary"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                        @if (CurrentObject.IsPrimary)
                                        {
                                            <RadzenIcon Icon="star" Style="color: gold;" /> @Localizer["Yes"]
                                        }
                                        else
                                        {
                                            @Localizer["No"]
                                        }
                                    </RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                @* Address Information Display *@
                <div class="read-only-section-header">@Localizer["AddressInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Address"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Address ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["City"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.City ?? "-")</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["State"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.State ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["PostalCode"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.PostalCode ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Country"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Country ?? "-")</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                @* Notes Section *@
                @if (!string.IsNullOrEmpty(CurrentObject.Notes))
                {
                    <div class="read-only-section-header">@Localizer["Notes"]</div>
                    <RadzenRow>
                        <RadzenColumn Size="12">
                            <div class="rz-p-4">
                                <RadzenText TextStyle="TextStyle.Body1">@CurrentObject.Notes</RadzenText>
                            </div>
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Contact" Data="@CurrentObject" Visible="@(CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new ContactValidator(Localizer)" />
            <ValidationSummary />
            <VanigamAccountingFormField Text=@Localizer["Customer"]>
                <ChildContent>
                    <RadzenDropDown @bind-Value="@CurrentObject.CustomerId"
                                    Data="@Customers"
                                    TextProperty="Name"
                                    ValueProperty="Oid"
                                    Placeholder="@Localizer["Select Customer"]"
                                    AllowClear="true"
                                    Name="dropdown_Customer" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Type"]>
                <ChildContent>
                    <ContactTypeEnumDropDown @bind-Value="@CurrentObject.Type" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["FirstName"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.FirstName" Name="txt_FirstName" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["LastName"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.LastName" Name="txt_LastName" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Email"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Email" Name="txt_Email" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Phone"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Phone" Name="txt_Phone" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Mobile"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Mobile" Name="txt_Mobile" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["JobTitle"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.JobTitle" Name="txt_JobTitle" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Department"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Department" Name="txt_Department" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["LinkedInProfile"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.LinkedInProfile" Name="txt_LinkedInProfile" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Status"]>
                <ChildContent>
                    <ContactStatusEnumDropDown @bind-Value="@CurrentObject.Status" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Address"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Address" Name="txt_Address" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["City"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.City" Name="txt_City" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["State"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.State" Name="txt_State" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["PostalCode"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.PostalCode" Name="txt_PostalCode" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Country"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Country" Name="txt_Country" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["IsPrimary"]>
                <ChildContent>
                    <RadzenCheckBox @bind-Value="@CurrentObject.IsPrimary" Name="chk_IsPrimary" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Notes"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Notes" Name="txt_Notes" Rows="4" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>

        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>

</RadzenColumn>