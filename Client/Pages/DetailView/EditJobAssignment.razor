@page "/edit-jobassignment"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<JobAssignment, EditJobAssignment>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditJobAssignment"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            @* Floating Edit Button - Only visible in read-only mode *@
            @if (IsEditButtonVisible)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.End" Gap="10px">
                    <RadzenFab Style="bottom: 12px; left: 12px;" Icon="edit" Click="@EnableEditMode" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" />
                </RadzenStack>
            }
            <RadzenTabs @bind-SelectedIndex="ReadOnlyTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    @* Job Assignment Information Display *@
                    <RadzenTabsItem Text="@Localizer[" Job Assignment Info"]" Icon="@FadIcon("fa-user-tie")">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Job"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Job.Title.ToString())</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    <RadzenBadge BadgeStyle="@Vanigam.CRM.Client.Helpers.BadgeHelper.GetBadgeStyle(CurrentObject.Status)" Text="@CurrentObject.Status.ToString()" />
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["AcceptedAt"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.AcceptedAt.HasValue ? CurrentObject.AcceptedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["AssignedAt"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.AssignedAt.HasValue ? CurrentObject.AssignedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</RadzenText>
                            </div>
                        </div>

                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="JobAssignment" Data="@CurrentObject" Visible="@(CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new JobAssignmentValidator(Localizer)" />
            <ValidationSummary />
            <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" class="rz-mt-4" TabPosition="TabPosition.Left">
                <Tabs>
                    @* JobAssignmentInformation Tab *@
                    <RadzenTabsItem Text="@Localizer["Job Assignment Info"]" class="fa-small">
                        <VanigamAccountingFormField Text=@Localizer["Job"]>
                            <ChildContent>
                                <JobDropDownDataGrid @bind-Value="@CurrentObject.JobId" Disabled="IsEmbeddedModeActive"></JobDropDownDataGrid>
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["Status"]>
                            <ChildContent>
                                <AssignmentStatusEnumDropDown @bind-Value="@CurrentObject.Status" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["AssignedAt"]>
                            <ChildContent>
                                <RadzenDatePicker @bind-Value="@CurrentObject.AssignedAt" Name="date_AssignedAt" ShowTime="true"  Max="DateTime.Now"/>
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["AcceptedAt"]>
                            <ChildContent>
                                <RadzenDatePicker @bind-Value="@CurrentObject.AcceptedAt" Name="date_AcceptedAt" ShowTime="true" Max="DateTime.Now" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenStack>

        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>

</RadzenColumn>