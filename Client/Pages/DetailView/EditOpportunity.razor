@page "/edit-opportunity"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@using Vanigam.CRM.Client.Pages.ListView
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Opportunity, EditOpportunity>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditOpportunity"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         Gap="10px">
                @* Convert to Customer Button - Only visible in read-only mode for qualified opportunities *@
                @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="10px">
                        <RadzenButton Text="@Localizer["ConvertToCustomer"]"
                                      Icon="person_add"
                                      ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small"
                                      Click="@ShowConvertToCustomerDialog"
                                      Disabled=@(!CanConvertToCustomer)
                                      class="rz-ml-2" Style="bottom: 12px; left: 10px;" />
                    </RadzenStack>
                }
                @* Floating Edit Button - Only visible in read-only mode *@

                <RadzenStack Orientation="Orientation.Horizontal" Gap="10px">
                    @if (IsEditButtonVisible && CurrentObject.Stage != OpportunityStage.ClosedWon)
                    {
                        <RadzenFab Style="bottom: 10px; left: 5px;" Icon="edit" Click="@EnableEditMode" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" />
                    }
                    else
                    {
                        <RadzenFab Style="bottom: 10px; left: 5px;" Icon="edit" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" Disabled="true" />
                    }
                </RadzenStack>

            </RadzenStack>
            <RadzenTabs @bind-SelectedIndex="ReadOnlyTabIndex" RenderMode="TabRenderMode.Client" Change="OnTabChanged" TabPosition="TabPosition.Left">
                <Tabs>
                    <RadzenTabsItem Text="@Localizer["OpportunityInformation"]" Icon="@FadIcon("fa-handshake")" class="fa-small">
                        <RadzenStack>
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenStack>
                                        <div class="rz-p-4">
                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Title"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Title ?? "-")</RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Description ?? "-")</RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EstimatedValue"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EstimatedValue.ToString("C"))</RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Source"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Source ?? "-")</RadzenText>
                                            </div>
                                        </div>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenStack>
                                        <div class="rz-p-4">
                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Stage"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                                    <RadzenBadge BadgeStyle="@Vanigam.CRM.Client.Helpers.BadgeHelper.GetBadgeStyle(CurrentObject.Stage)" Text="@CurrentObject.Stage.GetDisplayDescription().ToString()" class="rz-p-1" />
                                                </RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Probability"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Probability)%</RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ExpectedCloseDate"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.ExpectedCloseDate?.ToString("yyyy-MM-dd"))</RadzenText>
                                            </div>

                                            <div class="read-only-field rz-mb-3">
                                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Comments"]:</strong></RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Comments ?? "-")</RadzenText>
                                            </div>
                                        </div>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenTabsItem>
                    @if (CurrentObject.Lead != null)
                    {
                        <RadzenTabsItem Text="@Localizer["LeadInformation"]" Icon="@FadIcon("fa-user-tie")" class="fa-small">
                            <RadzenStack>
                                <RadzenRow>
                                    <RadzenColumn Size="6">
                                        <RadzenStack>
                                            <div class="rz-p-4">
                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Name"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Name ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Email"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Email ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Phone"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Phone ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Organization"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Organization ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["JobTitle"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.JobTitle ?? "-")</RadzenText>
                                                </div>
                                            </div>
                                        </RadzenStack>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6">
                                        <RadzenStack>
                                            <div class="rz-p-4">
                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                                        <RadzenBadge BadgeStyle="@Vanigam.CRM.Client.Helpers.BadgeHelper.GetBadgeStyle(CurrentObject.Lead.Status)" Text="@CurrentObject.Lead.Status.ToString()" class="rz-p-1" />
                                                    </RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Industry"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Industry ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Source"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.Source ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EstimatedBudget"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead.EstimatedBudget?.ToString("C") ?? "-")</RadzenText>
                                                </div>

                                                <div class="read-only-field rz-mb-3">
                                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["LeadScore"]:</strong></RadzenText>
                                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@CurrentObject.Lead.LeadScore</RadzenText>
                                                </div>
                                            </div>
                                        </RadzenStack>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                        </RadzenTabsItem>
                    }

                    @* Related Data Tabs - Available in both read-only and edit modes *@
                    @if (IsTabsVisible)
                    {
                        <RadzenTabsItem Text="@Localizer["Activities"]">
                            <Activities OpportunityId="@Oid"
                                        IsEmbeddedMode="true"
                                        EmbeddedTitle="@Localizer["OpportunityActivities"]" />
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    @if (CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))
    {

        <RadzenCard>
            <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Opportunity" Data="@CurrentObject" Submit="@SaveAndStayInEdit">
                <FluentValidationValidator Validator="new OpportunityValidator(Localizer)" />
                <ValidationSummary />

                <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                    <Tabs>
                        @* Basic Info Tab *@
                        <RadzenTabsItem Text="@Localizer["BasicInfo"]" Icon="@FadIcon("fa-handshake")" class="fa-small">
                            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                                <RadzenRadioButtonList TValue="OpportunityStage" Change="@Changed" Value="@CurrentObject.Stage">
                                    <Items>
                                        @foreach (var status in OpportunityStages)
                                        {
                                            <RadzenRadioButtonListItem Text="@Localizer[status.GetDisplayDescription().ToString()]" Value="status" />
                                        }
                                    </Items>
                                </RadzenRadioButtonList>
                            </RadzenStack>
                            <RadzenStack Gap="1rem" class="rz-p-2">
                                <VanigamAccountingFormField Text=@Localizer["Title"]>
                                    <ChildContent>
                                        <VanigamAccountingTextBox @bind-Value="@CurrentObject.Title" Name="txt_Title" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["EstimatedValue"]>
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@CurrentObject.EstimatedValue" Name="numeric_EstimatedValue" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["Source"]>
                                    <ChildContent>
                                        <VanigamAccountingTextBox @bind-Value="@CurrentObject.Source" Name="txt_Source" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["Description"]>
                                    <ChildContent>
                                        <RadzenTextArea @bind-Value="@CurrentObject.Description" Name="txt_Description" Rows="3" class="w-100" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                            </RadzenStack>
                        </RadzenTabsItem>

                        @* Details Tab *@
                        <RadzenTabsItem Text="@Localizer["Details"]" Icon="@FadIcon("fa-list-ul")" class="fa-small">
                            <RadzenStack Gap="1rem" class="rz-p-2">
                                @*<VanigamAccountingFormField Text=@Localizer["Stage"]>
                                    <ChildContent>
                                        <OpportunityStageEnumDropDown @bind-Value="@CurrentObject.Stage" />
                                    </ChildContent>
                                </VanigamAccountingFormField>*@
                                <VanigamAccountingFormField Text=@Localizer["Probability"]>
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@CurrentObject.Probability" Name="numeric_Probability" Min="0" Max="100" Step="5" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["ExpectedCloseDate"]>
                                    <ChildContent>
                                        <RadzenDatePicker @bind-Value="@CurrentObject.ExpectedCloseDate" Name="date_ExpectedCloseDate" class="w-100" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["Comments"]>
                                    <ChildContent>
                                        <RadzenTextArea @bind-Value="@CurrentObject.Comments" Name="txt_Comments" Rows="3" class="w-100" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                            </RadzenStack>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>

                <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    @if (IsCreateMode)
                    {
                        <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                    }
                    else
                    {
                        <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                        <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
                    }
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenColumn>