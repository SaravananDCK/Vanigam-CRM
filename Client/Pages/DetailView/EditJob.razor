@page "/edit-job"
@using Vanigam.CRM.Client.Pages.ListView
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Objects.DTOs
@using Vanigam.CRM.Client.Validators
@using Vanigam.CRM.Client.Components
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Job, EditJob>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditJob"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {

            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                @* Job Information Display *@
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Title"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Title ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Status.ToString())</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack>
                            <div class="rz-p-4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Description ?? "-")</RadzenText>
                                </div>

                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Priority"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Priority.ToString())</RadzenText>
                                </div>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

                @* Materials Display in Read-Only Mode *@
                @if (materials != null && materials.Any(m => !m.IsDeleted))
                {
                    <div class="read-only-section-header rz-mt-4">@Localizer["Materials"]</div>
                    <RadzenDataGrid AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="10" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
                                    Data="@materials.Where(m => !m.IsDeleted)" TItem="MaterialUsageDTO" ColumnWidth="300px" LogicalFilterOperator="LogicalFilterOperator.Or" class="rz-mt-3">
                        <Columns>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.InventoryItemName)" Title="@Localizer["Material"]" Width="300px" />
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.Quantity)" Title="@Localizer["Quantity"]" Width="100px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @material.Quantity
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.UnitPrice)" Title="@Localizer["UnitPrice"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @material.UnitPrice.ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.DiscountAmount)" Title="@Localizer["Discount"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @(material.DiscountAmount.ToString("C"))
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.TaxAmount)" Title="@Localizer["Tax"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @((material.TaxAmount ?? 0).ToString("C"))
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.Total)" Title="@Localizer["Line Total"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @material.Total.ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="MaterialUsageDTO" Property="@nameof(MaterialUsageDTO.TotalIncTax)" Title="@Localizer["Total Inc.Tax"]" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="material">
                                    @material.TotalIncTax.ToString("C")
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @* Job Summary Totals *@
                    <RadzenRow class="rz-mt-4">
                        <RadzenColumn Size="12" SizeMD="8"></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCard Variant="Variant.Outlined">
                                <RadzenStack Gap="0.5rem" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End">
                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["SubTotal"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.SubTotal.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["Discount"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.DiscountAmount.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["Tax"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                            @CurrentObject.TaxAmount.ToString("C")
                                        </RadzenText>
                                    </div>

                                    <hr style="border: 1px solid #ccc; margin: 5px 0;" />
                                    <div class="read-only-field">
                                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="field-label">
                                            <strong>@Localizer["Grand Total"]:</strong>
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="field-value">
                                            <strong>@CurrentObject.TotalAmount.ToString("C")</strong>
                                        </RadzenText>
                                    </div>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Job" Data="@CurrentObject" Visible="@(CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new JobValidator(Localizer)" />
            <ValidationSummary />
            <VanigamAccountingFormField Text=@Localizer["Title"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Title" Name="txt_Title" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Description"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Description" Name="txt_Description" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Status"]>
                <ChildContent>
                    <JobStatusEnumDropDown @bind-Value="@CurrentObject.Status" />
                </ChildContent>
            </VanigamAccountingFormField>
            <VanigamAccountingFormField Text=@Localizer["Priority"]>
                <ChildContent>
                    <PriorityEnumDropDown @bind-Value="@CurrentObject.Priority" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>
    </RadzenTemplateForm>

    @* Materials Section - Outside the main form *@
    @if (CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))
    {
        <RadzenCard class="rz-mb-4">
            <EditableJobMaterials Materials="@materials"
                                  MaterialsChanged="@OnMaterialsChanged"
                                  TotalAmountChanged="@OnTotalAmountChanged"
                                  TotalTaxChanged="@OnTotalTaxAmountChanged"
                                  DiscountChanged="@OnDiscountAmountChanged"
                                  DiscountPercentageChanged="@OnDiscountPercentageChanged"
                                  SubTotalChanged="@OnSubTotalChanged"
                                  DiscountTypeChanged="@OnDiscountTypeChanged"
                                  Job="@CurrentObject" />
        </RadzenCard>

        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!HasAnyChanges)" @bind-IsBusy="IsBusy" Click="@SaveBulkJob" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!HasAnyChanges)" @bind-IsBusy="IsBusy" Click="@SaveBulkJob" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyModeAsync" />
            }
        </RadzenStack>
    }

    @* Related Data Tabs - Available in both read-only and edit modes *@
    @if (CurrentObject != null && Oid != Guid.Empty)
    {
        <RadzenCard class="mt-4">
            <RadzenTabs @bind-SelectedIndex="SelectedTabIndex" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="@Localizer["Assignments"]">
                        <JobAssignments JobId="@Oid"
                                        IsEmbeddedMode="true"
                                        EmbeddedTitle="@Localizer["JobAssignments"]" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["Appointments"]">
                        <Appointments JobId="@Oid"
                                      IsEmbeddedMode="true"
                                      EmbeddedTitle="@Localizer["JobAppointments"]" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["MaterialUsages"]">
                        <MaterialUsages JobId="@Oid"
                                        IsEmbeddedMode="true"
                                        EmbeddedTitle="@Localizer["JobMaterialUsages"]" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["JobReports"]">
                        <JobReports JobId="@Oid"
                                    IsEmbeddedMode="true"
                                    EmbeddedTitle="@Localizer["JobReports"]" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }

</RadzenColumn>