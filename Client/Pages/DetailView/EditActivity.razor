@page "/edit-activity"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Activity, EditActivity>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditActivity"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (IsReadOnlyModeVisible)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                <div class="read-only-section-header">@Localizer["ActivityInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Subject"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Subject ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Type"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Type.ToString() ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Status"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Status.ToString() ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ActivityDate"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@GetActivityDateDisplay(CurrentObject.ActivityDate)</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Duration"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Duration?.ToString() ?? "-") @if(CurrentObject.Duration.HasValue) { <text>minutes</text> }</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Priority"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Priority.ToString())</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            @if (CurrentObject.LeadId.HasValue)
                            {
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Lead"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Lead?.Name ?? "-")</RadzenText>
                                </div>
                            }
                            @if (CurrentObject.OpportunityId.HasValue)
                            {
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Opportunity"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Opportunity?.Title ?? "-")</RadzenText>
                                </div>
                            }
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Description ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Outcome"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Outcome ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Notes"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Notes ?? "-")</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Activity" Data="@CurrentObject" Visible="@IsFormVisible" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new ActivityValidator(Localizer)" />
            <ValidationSummary />
            @if (LeadId == null && OpportunityId==null)
            {
                <VanigamAccountingFormField Text=@Localizer["Activity For"]>
                    <ChildContent>
                        <RadzenRadioButtonList @bind-Value=@ActivityFor TValue="int" JustifyContent="JustifyContent.Start" class="rz-m-2">
                            <Items>
                                <RadzenRadioButtonListItem Text="Lead" Value="0"/>
                                <RadzenRadioButtonListItem Text="Opportunity" Value="1"/>
                            </Items>
                        </RadzenRadioButtonList>
                    </ChildContent>
                </VanigamAccountingFormField>
                @if (ActivityFor == 0)
                {
                    <VanigamAccountingFormField Text=@Localizer["Lead"]>
                        <ChildContent>
                            <LeadDropDownDataGrid @bind-Value="CurrentObject.LeadId"/>
                        </ChildContent>
                    </VanigamAccountingFormField>
                }
                else if (ActivityFor == 1)
                {
                    <VanigamAccountingFormField Text=@Localizer["Opportunity"]>
                        <ChildContent>
                            <OpportunityDropDownDataGrid @bind-Value="CurrentObject.OpportunityId" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                }
            }
            <VanigamAccountingFormField Text=@Localizer["Subject"]>
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Subject" Name="txt_Subject" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Type"]>
                <ChildContent>
                    <RadzenDropDown @bind-Value="@CurrentObject.Type" Name="dd_Type" Data="@ActivityTypes" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Status"]>
                <ChildContent>
                    <RadzenDropDown @bind-Value="@CurrentObject.Status" Name="dd_Status" Data="@ActivityStatuses" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["ActivityDate"]>
                <ChildContent>
                    <RadzenDatePicker @bind-Value="@ActivityDateForUI" Name="date_ActivityDate" ShowTime="true" DateFormat="yyyy-MM-dd HH:mm" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Duration"]>
                <ChildContent>
                    <RadzenNumeric @bind-Value="@CurrentObject.Duration" Name="num_Duration" Placeholder="@Localizer["Minutes"]" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Priority"]>
                <ChildContent>
                    <PriorityEnumDropDown @bind-Value="@CurrentObject.Priority" />
                </ChildContent>
            </VanigamAccountingFormField>
            @if (CurrentObject.Opportunity!=null)
            {
                <VanigamAccountingFormField Text=@Localizer["Opportunity"]>
                    <ChildContent>
                        <VanigamAccountingTextBox Value="@(CurrentObject.Opportunity?.Title ?? "")" Name="txt_OpportunityTitle" Disabled="true" />
                    </ChildContent>
                </VanigamAccountingFormField>
            }

            <VanigamAccountingFormField Text=@Localizer["Description"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Description" Name="txt_Description" Rows="4" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Outcome"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Outcome" Name="txt_Outcome" Rows="3" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text=@Localizer["Notes"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Notes" Name="txt_Notes" Rows="4" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>
        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>