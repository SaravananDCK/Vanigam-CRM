@page "/edit-stockledgerentry"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<StockLedgerEntry, EditStockLedgerEntry>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditStockLedgerEntry"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["EntryNumberMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (IsReadOnlyModeVisible)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                <div class="read-only-section-header">@Localizer["StockLedgerEntryInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EntryNumber"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EntryNumber ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EntryDate"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EntryDate.ToString("yyyy-MM-dd"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["MovementType"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.MovementType.ToString())</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Item"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.InventoryItem?.Name ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Location"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Location?.Name ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["QuantityIn"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.QuantityIn.ToString("N2") ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["QuantityOut"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.QuantityOut.ToString("N2") ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Balance"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Balance.ToString("N2"))</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["UnitCost"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.UnitCost.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TotalValue"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.TotalValue.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["BatchNumber"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.BatchNumber ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ExpiryDate"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Reference"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Reference ?? "-")</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
                @if (!string.IsNullOrEmpty(CurrentObject.Description))
                {
                    <div class="rz-p-4">
                        <div class="read-only-field">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@CurrentObject.Description</RadzenText>
                        </div>
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="StockLedgerEntry" Data="@CurrentObject" Visible="@IsFormVisible" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new StockLedgerEntryValidator(Localizer)" />
            <ValidationSummary />
            <RadzenRow>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["EntryNumber"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.EntryNumber" Name="txt_EntryNumber" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["EntryDate"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.EntryDate" Name="dt_EntryDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["MovementType"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.MovementType" Data="@(Enum.GetValues(typeof(StockMovementType)))" Name="dd_MovementType" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Item"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.InventoryItemId" Data="@InventoryItems" TextProperty="Name" ValueProperty="Oid" Name="dd_InventoryItem" class="w-100" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Location"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.LocationId" Data="@Locations" TextProperty="Name" ValueProperty="Oid" Name="dd_Location" class="w-100" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["QuantityIn"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.QuantityIn" Name="num_QuantityIn" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["QuantityOut"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.QuantityOut" Name="num_QuantityOut" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["Balance"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.Balance" Name="num_Balance" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["UnitCost"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.UnitCost" Name="num_UnitCost" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["TotalValue"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.TotalValue" Name="num_TotalValue" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["BatchNumber"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.BatchNumber" Name="txt_BatchNumber" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["ExpiryDate"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.ExpiryDate" Name="dt_ExpiryDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Reference"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.Reference" Name="txt_Reference" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                </RadzenColumn>
            </RadzenRow>
            <VanigamAccountingFormField Text=@Localizer["Description"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Description" Name="txt_Description" Rows="4" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>
        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>
