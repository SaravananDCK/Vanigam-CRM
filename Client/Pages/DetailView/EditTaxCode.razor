@page "/taxcode/{oid:guid}"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseDetailView<TaxCode, EditTaxCode>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject TaxCodeApiService TaxCodeApiService
@inject LedgerAccountApiService LedgerAccountApiService

<DetailPageTitleComponent TitleText="@Localizer[IsCreateMode ? "AddTaxCode" : "EditTaxCode"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid" />
@if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
{
    <RadzenStack Style="margin: 1rem">
        <RadzenRow Gap="1rem" RowGap="1rem">
            @if (IsEditButtonVisible)
            {
                <RadzenColumn SizeMD="12">

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.End" Gap="10px">
                        <RadzenFab Style="bottom: 12px; left: 12px;" Icon="edit" Click="@EnableEditMode" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" />
                    </RadzenStack>
                </RadzenColumn>
            }
            <RadzenColumn SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-mb-3">
                        @Localizer["BasicInformation"]
                    </RadzenText>
                    <div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Code"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject?.Code ?? "-")</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Name"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject?.Name ?? "-")</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxType"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject?.TaxType ?? "-")</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IsActive"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject?.IsActive)</RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject?.Description ?? "-")</RadzenText>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-mb-3">
                        @Localizer["TaxRates"]
                    </RadzenText>
                    <div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxRate"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(@CurrentObject?.TaxRate.ToString("N2") + "%")</RadzenText>
                        </div>
                        @if (CurrentObject?.CGSTRate > 0)
                        {
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["CGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.CGSTRate.ToString("N2") + "%")
                                </RadzenText>
                            </div>
                        }

                        @if (CurrentObject?.SGSTRate > 0)
                        {
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.SGSTRate.ToString("N2") + "%")
                                </RadzenText>
                            </div>
                        }

                        @if (CurrentObject?.IGSTRate > 0)
                        {
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.IGSTRate.ToString("N2") + "%")
                                </RadzenText>
                            </div>
                        }

                        @if (CurrentObject?.UTGSTRate > 0)
                        {
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["UTGST"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.UTGSTRate.ToString("N2") + "%")
                                </RadzenText>
                            </div>
                        }
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["CessRate"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                @(CurrentObject?.CessRate > 0 ? CurrentObject.CessRate.ToString("N2") + "%" : "-")
                            </RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IsCompoundTax"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                @(CurrentObject?.IsCompoundTax == true ? Localizer["Yes"] : Localizer["No"])
                            </RadzenText>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-mb-3">
                        @Localizer["EffectiveDates"]
                    </RadzenText>
                    <div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EffectiveFrom"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                @CurrentObject?.EffectiveFrom?.ToString("dd-MMM-yyyy")
                            </RadzenText>
                        </div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EffectiveTo"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                @CurrentObject?.EffectiveTo?.ToString("dd-MMM-yyyy")
                            </RadzenText>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" class="rz-mb-3">
                        @Localizer["AccountMappings"]
                    </RadzenText>
                    <div>
                        <div class="read-only-field rz-mb-3">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxPayableAccount"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                @CurrentObject?.TaxPayableAccount?.Name
                            </RadzenText>
                        </div>
                        <div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["TaxReceivableAccount"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @CurrentObject?.TaxReceivableAccount?.Name
                                </RadzenText>
                            </div>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
}

@if (CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))
{
    <RadzenCard>
        <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="TaxCode" Data="@CurrentObject" Submit="@SaveAndStayInEdit">
            <FluentValidationValidator Validator="new Vanigam.CRM.Client.Validators.TaxCodeValidator(Localizer)" />
            <ValidationSummary />

            <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    <RadzenTabsItem Text="@Localizer["BasicInformation"]" Icon="@FadIcon("fa-user")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["Code"]>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@CurrentObject!.Code" Name="txt_Code" class="w-100" />
                                </ChildContent>
                            </VanigamAccountingFormField>

                            <VanigamAccountingFormField Text=@Localizer["Name"]>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@CurrentObject!.Name" Name="txt_Name" class="w-100" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["TaxType"]>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="@CurrentObject!.TaxType" Name="ddl_TaxType" class="w-100" Placeholder="GST, VAT, etc." />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["Description"]>
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="@CurrentObject!.Description" Name="txt_Description" class="w-100" Rows="3" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <div class="rz-p-1 rz-text-align-left">
                                <RadzenCheckBox @bind-Value=@CurrentObject.IsActive Name="chk_IsActive" />
                                <RadzenLabel Text=@Localizer["IsActive"] Component="chk_IsActive" class="rz-ms-2" />
                            </div>
                        </RadzenStack>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["TaxRates"]" Icon="@FadIcon("fa-file-invoice-dollar")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["TaxRate"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.TaxRate" Name="num_TaxRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["CGST"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.CGSTRate" Name="num_CGSTRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["SGST"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.SGSTRate" Name="num_SGSTRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["IGST"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.IGSTRate" Name="num_IGSTRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["UTGST"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.UTGSTRate" Name="num_UTGSTRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["CessRate"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject!.CessRate" Name="num_CessRate" class="w-100" TValue="double" Format="0.00" Step="0.01M" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <div class="rz-p-1 rz-text-align-left">
                                <RadzenCheckBox @bind-Value=@CurrentObject.IsCompoundTax Name="chk_IsCompoundTax" />
                                <RadzenLabel Text=@Localizer["IsCompoundTax"] Component="chk_IsCompoundTax" class="rz-ms-2" />
                            </div>
                        </RadzenStack>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["EffectiveDates"]" Icon="@FadIcon("fa-calendar-days")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["EffectiveFrom"]>
                                <ChildContent>
                                    <RadzenDatePicker @bind-Value="@CurrentObject!.EffectiveFrom" Name="dt_EffectiveFrom" class="w-100" DateFormat="dd-MMM-yyyy" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["EffectiveTo"]>
                                <ChildContent>
                                    <RadzenDatePicker @bind-Value="@CurrentObject!.EffectiveTo" Name="dt_EffectiveTo" class="w-100" DateFormat="dd-MMM-yyyy" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                        </RadzenStack>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@Localizer["AccountMappings"]" Icon="@FadIcon("fa-user")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["TaxPayableAccount"]>
                                <ChildContent>
                                    <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject!.TaxPayableAccountId"
                                                                   Name="ddl_TaxPayableAccount" class="w-100"
                                                                   Placeholder="@Localizer[" SelectAccount"]" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["TaxReceivableAccount"]>
                                <ChildContent>
                                    <LedgerAccountDropDownDataGrid @bind-Value="@CurrentObject!.TaxReceivableAccountId"
                                                                   Name="ddl_TaxReceivableAccount" class="w-100"
                                                                   Placeholder="@Localizer["SelectAccount"]" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                @if (IsCreateMode)
                {
                    <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                }
                else
                {
                    <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                    <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
                }
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
}
