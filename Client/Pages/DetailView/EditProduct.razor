@page "/edit-Product"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Product, EditProduct>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditProduct"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid" />

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display with Tabs *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            @if (IsEditButtonVisible)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.End" Gap="10px">
                    <RadzenFab Style="bottom: 12px; left: 12px;" Icon="edit" Click="@EnableEditMode" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" />
                </RadzenStack>
            }
            <RadzenTabs @bind-SelectedIndex="ReadOnlyTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    @* Basic Info Tab *@
                    <RadzenTabsItem Text="@Localizer["BasicInfo"]" Icon="@FadIcon("fa-info")" class="fa-small">
                        <div class="rz-p-1">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Name"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Name ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SKU"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.SKU ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Manufacturer"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Manufacturer ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ModelNumber"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.ModelNumber ?? "-")</RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    @* Pricing Tab *@
                    <RadzenTabsItem Text="@Localizer["Pricing"]" Icon="@FadIcon("fa-dollar-sign")" class="fa-small">
                        <div class="rz-p-1">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["UnitPrice"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.UnitPrice.ToString("C"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Cost"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Cost?.ToString("C") ?? "-")</RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    @* Warranty & AMC Tab *@
                    <RadzenTabsItem Text="@Localizer["WarrantyAMC"]" Icon="@FadIcon("fa-shield-alt")" class="fa-small">
                        <div class="rz-p-1">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["WarrantyPeriodMonths"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.WarrantyPeriodMonths?.ToString() ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["GuaranteePeriodMonths"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.GuaranteePeriodMonths?.ToString() ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IsAmcEligible"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.IsAmcEligible ? Localizer["Yes"] : Localizer["No"])</RadzenText>
                            </div>
                            @if (CurrentObject.IsAmcEligible)
                            {
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["AmcAnnualRate"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.AmcAnnualRate?.ToString("C") ?? "-")</RadzenText>
                                </div>
                            }
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["RequiresPurchaseProof"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.RequiresPurchaseProof ? Localizer["Yes"] : Localizer["No"])</RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }

    @* Editable Form Mode with Tabs *@
    <RadzenCard Visible="@(CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))">
        <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Product" Data="@CurrentObject" Submit="@SaveAndStayInEdit">
            <FluentValidationValidator Validator="new ProductValidator(Localizer)" />
            <ValidationSummary />

            <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    @* Basic Info Tab *@
                    <RadzenTabsItem Text="@Localizer["BasicInfo"]" Icon="@FadIcon("fa-info")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["Name"]>
                                <ChildContent>
                                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Name" Name="txt_Name" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["SKU"]>
                                <ChildContent>
                                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.SKU" Name="txt_SKU" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["Manufacturer"]>
                                <ChildContent>
                                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.Manufacturer" Name="txt_Manufacturer" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["ModelNumber"]>
                                <ChildContent>
                                    <VanigamAccountingTextBox @bind-Value="@CurrentObject.ModelNumber" Name="txt_ModelNumber" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                        </RadzenStack>
                    </RadzenTabsItem>

                    @* Pricing Tab *@
                    <RadzenTabsItem Text="@Localizer["Pricing"]" Icon="@FadIcon("fa-dollar-sign")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["UnitPrice"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject.UnitPrice" Name="numeric_UnitPrice" Format="C" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["Cost"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject.Cost" Name="numeric_Cost" Format="C" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                        </RadzenStack>
                    </RadzenTabsItem>

                    @* Warranty & AMC Tab *@
                    <RadzenTabsItem Text="@Localizer["WarrantyAMC"]" Icon="@FadIcon("fa-shield-alt")" class="fa-small">
                        <RadzenStack Gap="1rem">
                            <VanigamAccountingFormField Text=@Localizer["WarrantyPeriodMonths"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject.WarrantyPeriodMonths" Name="numeric_WarrantyPeriodMonths" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <VanigamAccountingFormField Text=@Localizer["GuaranteePeriodMonths"]>
                                <ChildContent>
                                    <RadzenNumeric @bind-Value="@CurrentObject.GuaranteePeriodMonths" Name="numeric_GuaranteePeriodMonths" />
                                </ChildContent>
                            </VanigamAccountingFormField>
                            <div class="rz-p-1 rz-text-align-left">
                                <RadzenCheckBox @bind-Value=@CurrentObject.IsAmcEligible Name="chk_IsAmcEligible" />
                                <RadzenLabel Text=@Localizer["IsAmcEligible"] Component="chk_IsAmcEligible" class="rz-ms-2" />
                            </div>

                            @if (CurrentObject.IsAmcEligible)
                            {
                                <VanigamAccountingFormField Text=@Localizer["AmcAnnualRate"]>
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@CurrentObject.AmcAnnualRate" Name="numeric_AmcAnnualRate" Format="C" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                            }
                            <div class="rz-p-1 rz-text-align-left">
                                <RadzenCheckBox @bind-Value=@CurrentObject.RequiresPurchaseProof Name="chk_RequiresPurchaseProof" />
                                <RadzenLabel Text=@Localizer["RequiresPurchaseProof"] Component="chk_RequiresPurchaseProof" class="rz-ms-2" />
                            </div>
                        </RadzenStack>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            <RadzenStack Style="margin-top:0.5rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                @if (IsCreateMode)
                {
                    <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                }
                else
                {
                    <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                    <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
                }
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenColumn>