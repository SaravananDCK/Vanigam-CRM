@page "/edit-contract"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Contract, EditContract>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditContract"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["UnableSave"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (IsReadOnlyModeVisible)
    {
        <RadzenCard class="rz-my-4">
            <RadzenTabs @bind-SelectedIndex="ReadOnlyTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    @* Basic Info Tab *@
                    <RadzenTabsItem Text="@Localizer["BasicInfo"]" Icon="@FadIcon("fa-file-contract")" class="fa-small">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["Customer"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.Customer?.Name ?? "-")
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["Title"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.Title ?? "-")
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["StartDate"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.StartDate?.ToString("yyyy-MM-dd") ?? "-")
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["Duration"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @CurrentObject.Duration.ToString()
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["EndDate"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.EndDate?.ToString("yyyy-MM-dd") ?? "-")
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["Status"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @if (CurrentObject.IsActive)
                                    {
                                        <RadzenBadge Text=@Localizer["Active"] BadgeStyle="BadgeStyle.Success" class="rz-p-1" />
                                    }
                                    else
                                    {
                                        <RadzenBadge Text=@Localizer["Inactive"] BadgeStyle="BadgeStyle.Secondary" class="rz-p-1" />
                                    }
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    @* Coverage Details Tab *@
                    <RadzenTabsItem Text="@Localizer["CoverageDetails"]" Icon="@FadIcon("fa-shield-alt")" class="fa-small">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["CoverageType"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @CurrentObject.CoverageType.ToString()
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["IncludesPartsReplacement"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @if (CurrentObject.IncludesPartsReplacement)
                                    {
                                        <RadzenBadge Text=@Localizer["Yes"] BadgeStyle="BadgeStyle.Success" class="rz-p-1" />
                                    }
                                    else
                                    {
                                        <RadzenBadge Text=@Localizer["No"] BadgeStyle="BadgeStyle.Secondary" class="rz-p-1" />
                                    }
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["PartsReplacementLimit"]:</strong>
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                    @(CurrentObject.PartsReplacementLimit?.ToString("N2") ?? "-")
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    @* Terms Tab - Conditional *@
                    @if (!string.IsNullOrEmpty(CurrentObject.Terms))
                    {
                        <RadzenTabsItem Text="@Localizer["Terms"]" Icon="@FadIcon("fa-file-alt")" class="fa-small">
                            <div class="rz-p-4">
                                <div class="read-only-field">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                        <strong>@Localizer["Terms"]:</strong>
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">
                                        @CurrentObject.Terms
                                    </RadzenText>
                                </div>
                            </div>
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    @if (IsFormVisible)
    {
        <RadzenCard>
            <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Contract" Data="@CurrentObject" Submit="@SaveAndStayInEdit">
                <FluentValidationValidator Validator="new ContractValidator(Localizer)" />
                <ValidationSummary />

                <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                    <Tabs>
                        <RadzenTabsItem Text="@Localizer["BasicInfo"]" Icon="@FadIcon("fa-file-contract")" class="fa-small">
                            <RadzenStack Gap="1rem" class="rz-p-4">
                                <VanigamAccountingFormField Text=@Localizer["Customer"]>
                                    <ChildContent>
                                        <CustomerDropDownDataGrid @bind-Value="@CurrentObject.CustomerId" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["Duration"]>
                                    <ChildContent>
                                        <ContractDurationEnumDropDown Value="@CurrentObject.Duration"
                                                                      ValueChanged="@((ContractDuration value) => { OnDurationChanged(value); })" />
                                    </ChildContent>
                                </VanigamAccountingFormField>

                                <VanigamAccountingFormField Text=@Localizer["StartDate"]>
                                    <ChildContent>
                                        <RadzenDatePicker Value="@CurrentObject.StartDate"
                                                          ValueChanged="@((DateTimeOffset? value) => { OnStartDateChanged(value); })"
                                                          Name="date_StartDate"
                                                          class="w-100" />
                                    </ChildContent>
                                </VanigamAccountingFormField>

                                <VanigamAccountingFormField Text=@Localizer["Title"]>
                                    <ChildContent>
                                        <VanigamAccountingTextBox @bind-Value="@CurrentObject.Title" Name="txt_Title" />
                                    </ChildContent>
                                </VanigamAccountingFormField>


                                <VanigamAccountingFormField Text=@Localizer["EndDate"]>
                                    <ChildContent>
                                        <RadzenTextBox Value="@(CurrentObject.EndDate?.ToString("yyyy-MM-dd") ?? "-")"
                                                       ReadOnly="true"
                                                       class="w-100"
                                                       Style="background-color: #f5f5f5;" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                
                                <div class="rz-p-1 rz-text-align-left">
                                    <RadzenCheckBox @bind-Value=@CurrentObject.IsActive Name="chk_IsActive" />
                                    <RadzenLabel Text=@Localizer["IsActive"] Component="chk_IsActive" class="rz-ms-2" />
                                </div>
                            </RadzenStack>
                        </RadzenTabsItem>

                        @* Coverage Details Tab *@
                        <RadzenTabsItem Text="@Localizer["CoverageDetails"]" Icon="@FadIcon("fa-shield-alt")" class="fa-small">
                            <RadzenStack Gap="1rem" class="rz-p-4">
                                <VanigamAccountingFormField Text=@Localizer["CoverageType"]>
                                    <ChildContent>
                                        <ContractCoverageTypeEnumDropDown @bind-Value="@CurrentObject.CoverageType" Style="width: 100%;" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                
                                <div class="rz-p-1 rz-text-align-left">
                                    <RadzenCheckBox @bind-Value=@CurrentObject.IncludesPartsReplacement Name="chk_IncludesPartsReplacement" />
                                    <RadzenLabel Text=@Localizer["Yes"] Component="chk_IncludesPartsReplacement" class="rz-ms-2" />
                                </div>

                                <VanigamAccountingFormField Text=@Localizer["PartsReplacementLimit"]>
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="@CurrentObject.PartsReplacementLimit"
                                                       Name="num_PartsReplacementLimit"
                                                       Format="n2"
                                                       ShowUpDown="false"
                                                       Style="width: 100%;" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                            </RadzenStack>
                        </RadzenTabsItem>

                        @* Terms Tab *@
                        <RadzenTabsItem Text="@Localizer["Terms"]" Icon="@FadIcon("fa-file-alt")" class="fa-small">
                            <RadzenStack Gap="1rem" class="rz-p-4">
                                <VanigamAccountingFormField Text=@Localizer["Terms"]>
                                    <ChildContent>
                                        <RadzenTextArea @bind-Value="@CurrentObject.Terms" Name="txt_Terms" Rows="4" class="w-100" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                            </RadzenStack>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    @if (IsCreateMode)
                    {
                        <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                    }
                    else
                    {
                        <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                        <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
                    }
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
    @* Related Data Tabs - Available in both read-only and edit modes *@
    @if (IsTabsVisible)
    {
        <RadzenCard class="mt-4">
            <RadzenTabs @bind-SelectedIndex="SelectedTabIndex" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text=@Localizer["CoverageRules"]>
                        <ContractCoverageRulesEmbedded ContractId="@Oid" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text=@Localizer["RecurringJobs"]>
                        <RecurringJobsEmbedded ContractId="@Oid" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }
</RadzenColumn>