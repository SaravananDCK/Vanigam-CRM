@page "/edit-ledgerentry"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<LedgerEntry, EditLedgerEntry>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]

@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditLedgerEntry"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
    <CustomBadge>
        @* Floating Edit Button - Only visible in read-only mode *@
        @if (IsEditButtonVisible)
        {
            <VanigamEditButton Click="@EnableEditMode" Title="@Localizer["Edit"]"/>
        }
    </CustomBadge>
</DetailPageTitleComponent>

<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["EntryNumberMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (IsReadOnlyModeVisible)
    {
        <RadzenCard class="rz-my-4">
            <RadzenStack>
                <div class="read-only-section-header">@Localizer["LedgerEntryInformation"]</div>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EntryNumber"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EntryNumber ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EntryDate"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EntryDate.ToString("yyyy-MM-dd"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Type"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EntryType.ToString())</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Amount"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Amount.ToString("C2"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Account"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Account?.Name ?? "-")</RadzenText>
                            </div>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Reference"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Reference ?? "-")</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Reconciled"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.IsReconciled ? Localizer["Yes"] : Localizer["No"])</RadzenText>
                            </div>
                            @if (CurrentObject.IsReconciled)
                            {
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ReconciledDate"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.ReconciledDate?.ToString("yyyy-MM-dd") ?? "-")</RadzenText>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["ReconciledBy"]:</strong></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.ReconciledBy ?? "-")</RadzenText>
                                </div>
                            }
                        </div>
                    </RadzenColumn>
                </RadzenRow>
                @if (!string.IsNullOrEmpty(CurrentObject.Description))
                {
                    <div class="rz-p-4">
                        <div class="read-only-field">
                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Description"]:</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@CurrentObject.Description</RadzenText>
                        </div>
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* Editable Form Mode *@
    <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="LedgerEntry" Data="@CurrentObject" Visible="@IsFormVisible" Submit="@SaveAndStayInEdit">
        <RadzenStack>
            <FluentValidationValidator Validator="new LedgerEntryValidator(Localizer)" />
            <ValidationSummary />
            <RadzenRow>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["EntryNumber"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.EntryNumber" Name="txt_EntryNumber" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["EntryDate"]>
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="@CurrentObject.EntryDate" Name="dt_EntryDate" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Type"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.EntryType" Data="@(Enum.GetValues(typeof(EntryType)))" Name="dd_EntryType" class="w-100" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Amount"]>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@CurrentObject.Amount" Name="num_Amount" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Account"]>
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@CurrentObject.AccountId" Data="@LedgerAccounts" TextProperty="Name" ValueProperty="Oid" Name="dd_Account" class="w-100" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <VanigamAccountingFormField Text=@Localizer["Reference"]>
                        <ChildContent>
                            <VanigamAccountingTextBox @bind-Value="@CurrentObject.Reference" Name="txt_Reference" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    <VanigamAccountingFormField Text=@Localizer["Reconciled"]>
                        <ChildContent>
                            <RadzenCheckBox @bind-Value="@CurrentObject.IsReconciled" Name="chk_IsReconciled" />
                        </ChildContent>
                    </VanigamAccountingFormField>
                    @if (CurrentObject.IsReconciled)
                    {
                        <VanigamAccountingFormField Text=@Localizer["ReconciledDate"]>
                            <ChildContent>
                                <RadzenDatePicker @bind-Value="@CurrentObject.ReconciledDate" Name="dt_ReconciledDate" class="w-100" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                        <VanigamAccountingFormField Text=@Localizer["ReconciledBy"]>
                            <ChildContent>
                                <VanigamAccountingTextBox @bind-Value="@CurrentObject.ReconciledBy" Name="txt_ReconciledBy" />
                            </ChildContent>
                        </VanigamAccountingFormField>
                    }
                </RadzenColumn>
            </RadzenRow>
            <VanigamAccountingFormField Text=@Localizer["Description"]>
                <ChildContent>
                    <RadzenTextArea @bind-Value="@CurrentObject.Description" Name="txt_Description" Rows="4" class="w-100" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>
        <RadzenStack Style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (IsCreateMode)
            {
                <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
            }
            else
            {
                <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@IsFormUnmodified" @bind-IsBusy="IsBusy" />
                <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
            }
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>
