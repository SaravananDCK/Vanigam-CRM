@page "/edit-appointment"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Validators
@inherits Vanigam.CRM.Client.Components.BaseDetailView<Appointment, EditAppointment>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@* Custom Header with Edit Button *@
<DetailPageTitleComponent TitleText="@Localizer["EditAppointment"]" DialogService="@DialogService" CanEdit="@CanEdit" HasChanges="@HasChanges" CurrentOid="@Oid">
</DetailPageTitleComponent>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@ErrorVisible">@Localizer["SaveAlert"]</RadzenAlert>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" Visible="@ShowNotUniqueAlert">@Localizer["CodeMust"]</RadzenAlert>

    @* Read-Only Mode Display *@
    @if (CurrentObject != null && IsReadOnlyMode && !IsCreateMode)
    {
        <RadzenCard class="rz-my-4">
            @* Floating Edit Button - Only visible in read-only mode *@
            @if (IsEditButtonVisible)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.End" Gap="10px">
                    <RadzenFab Style="bottom: 12px; left: 12px;" Icon="edit" Click="@EnableEditMode" Size="ButtonSize.Medium" Title="@Localizer["Edit"]" />
                </RadzenStack>
            }
            <RadzenTabs @bind-SelectedIndex="ReadOnlyTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                <Tabs>
                    @* Appointment Information Display *@
                    <RadzenTabsItem Text="@Localizer["Appointment Info"]" Icon="@FadIcon("fa-calendar")">
                        <div class="rz-p-4">
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Job"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.Job.Title.ToString())</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label">
                                    <strong>@Localizer["Status"]:</strong>
                                    <RadzenBadge BadgeStyle="@Vanigam.CRM.Client.Helpers.BadgeHelper.GetBadgeStyle(CurrentObject.Status)" Text="@CurrentObject.Status.ToString()" class="rz-p-1" />
                                </RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["StartAt"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.StartAt?.ToString("yyyy-MM-dd HH:mm"))</RadzenText>
                            </div>
                            <div class="read-only-field rz-mb-3">
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["EndAt"]:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value">@(CurrentObject.EndAt?.ToString("yyyy-MM-dd HH:mm"))</RadzenText>
                            </div>
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    }



    @* Editable Form Mode *@
    @if (CurrentObject != null && CanEdit && (!IsReadOnlyMode || IsCreateMode))
    {
        <RadzenCard class="rz-my-4">
            <RadzenTemplateForm @ref=Form EditContext="EditContext" TItem="Appointment" Data="@CurrentObject" Submit="@SaveAndStayInEdit">
                <RadzenStack>
                    <FluentValidationValidator Validator="new AppointmentValidator(Localizer)" />
                    <ValidationSummary />
                    <RadzenTabs @bind-SelectedIndex="EditTabIndex" RenderMode="TabRenderMode.Client" TabPosition="TabPosition.Left">
                        <Tabs>
                            @* Appointment Tab *@
                            <RadzenTabsItem Text="@Localizer["Appointment Info"]" class="fa-small">
                                <VanigamAccountingFormField Text=@Localizer["Job"]>
                                    <ChildContent>
                                        <JobDropDownDataGrid @bind-Value="@CurrentObject.JobId" Disabled="IsEmbeddedModeActive"></JobDropDownDataGrid>
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["Status"]>
                                    <ChildContent>
                                        <AppointmentStatusEnumDropDown @bind-Value="@CurrentObject.Status" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["StartAt"]>
                                    <ChildContent>
                                        <RadzenDatePicker @bind-Value="@CurrentObject.StartAt" Name="date_StartAt" ShowTime="true" Max="DateTime.Now" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <VanigamAccountingFormField Text=@Localizer["EndAt"]>
                                    <ChildContent>
                                        <RadzenDatePicker @bind-Value="@CurrentObject.EndAt" Name="date_EndAt" ShowTime="true" Max="DateTime.Now" />
                                    </ChildContent>
                                </VanigamAccountingFormField>
                                <RadzenStack Style="margin-top:0.5rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                    @if (IsCreateMode)
                                    {
                                        <VanigamAccountingSaveButton Id="btn_Save" Text="@Localizer["Save"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                                    }
                                    else
                                    {
                                        <VanigamAccountingSaveButton Id="btn_Update" Text="@Localizer["Update"]" Disabled="@(!(Form.EditContext.IsModified()))" @bind-IsBusy="IsBusy" />
                                        <VanigamAccountingCancelButton Text="@Localizer["Cancel"]" Click="@EnableReadOnlyMode" />
                                    }
                                </RadzenStack>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    }
</RadzenColumn>