@page "/quotes"
@using Vanigam.CRM.Client.Services
@using Vanigam.CRM.Objects.Entities
@inherits Vanigam.CRM.Client.Components.BaseListView<Quote, Quotes>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject QuoteApiService QuoteApiService
@inject PdfApiService PdfApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Quotes"] : Localizer["Quotes"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || JobId.HasValue) />
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Quote" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Quote" Filterable="false" Sortable="false" Width="200px" Title="@Localizer["Actions"]">
                        <Template Context="quote">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <OpenPageCommonComponent T="Quote" OpenObject="@quote" Open="@Open"></OpenPageCommonComponent>
                                <DeletePageCommonComponent T="Quote" UsingObject="@quote" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="preview" Size="ButtonSize.ExtraSmall"
                                             Click="@(() => PreviewPdf(quote.Oid))" Title="@Localizer["Preview PDF"]" />
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="download" Size="ButtonSize.ExtraSmall"
                                             Click="@(() => DownloadPdf(quote.Oid))" Title="@Localizer["Download PDF"]" />
                            </RadzenStack>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property="Job.Title" Title=@Localizer["Job"] Visible="@(!IsEmbeddedMode)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.Title) Title=@Localizer["Title"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.Status) Title=@Localizer["Status"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.TotalAmount) Title=@Localizer["TotalAmount"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Guid? JobId { get; set; }
    [Parameter] public bool IsEmbeddedMode { get; set; } = false;
    [Parameter] public string? EmbeddedTitle { get; set; }

    private async Task PreviewPdf(Guid quoteId)
    {
        await PdfApiService.PreviewQuotePdfAsync(quoteId);
    }

    private async Task DownloadPdf(Guid quoteId)
    {
        await PdfApiService.DownloadQuotePdfAsync(quoteId);
    }
}