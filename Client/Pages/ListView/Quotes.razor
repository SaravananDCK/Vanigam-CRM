@page "/quotes"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseListView<Quote, Quotes>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject QuoteApiService QuoteApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Quotes"] : Localizer["Quotes"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || JobId.HasValue)>
        <RadioButtons>
            @* Status Filter Bar using RadzenTabs with FilterTabTemplate *@
            @if (!IsEmbeddedMode)
            {
                <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndexChanged="OnStatusTabChange"
                            TabPosition="TabPosition.Top" class="modern-tabs">
                    <Tabs>
                        <RadzenTabsItem>
                            <Template>
                                <FilterTabTemplate Text="@Localizer["All"]"
                                                 Count="@(TotalCount.ToString() ?? "0")"
                                                 Icon="@FadIcon("fa-list")"
                                                 Style="@BadgeStyle.Primary" />
                            </Template>
                        </RadzenTabsItem>
                        @foreach (QuoteStatus status in Enum.GetValues<QuoteStatus>())
                        {
                            <RadzenTabsItem>
                                <Template>
                                    <FilterTabTemplate Text="@Localizer[status.ToString()]"
                                                     Count="@(GetStatusCount(status).ToString())"
                                                     Icon="@FadIcon(GetIcon(status))"
                                                     Style="@GetStatusBadgeStyle(status)" />
                                </Template>
                            </RadzenTabsItem>
                        }
                    </Tabs>
                </RadzenTabs>
            }
        </RadioButtons>
    </ListPageTitleComponent>
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Quote" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Quote" Filterable="false" Sortable="false" Width="200px" Title="@Localizer["Actions"]">
                        <Template Context="quote">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <OpenPageCommonComponent T="Quote" OpenObject="@quote" Open="@Open"></OpenPageCommonComponent>
                                <DeletePageCommonComponent T="Quote" UsingObject="@quote" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="preview" Size="ButtonSize.ExtraSmall"
                                             Click="@(() => PreviewPdf(quote))" Title="@Localizer["Preview PDF"]" />
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="download" Size="ButtonSize.ExtraSmall"
                                             Click="@(() => DownloadPdf(quote))" Title="@Localizer["Download PDF"]" />
                            </RadzenStack>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.VoucherDate) Title=@Localizer["Date"]>
                        <Template>
                            @context.VoucherDate.ToHumanDateTime()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property="@nameof(Quote.Number)" Title=@Localizer["Number"] Visible="@(!IsEmbeddedMode)">
                    </RadzenDataGridColumn>
                    
                    <RadzenDataGridColumn TItem="Quote" Property="@PropertyExtensions.GetPropertyFullPath((Quote i) => i.Party.Name)" Title=@Localizer["Customer"] Visible="@(!IsEmbeddedMode)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.Status) Title=@Localizer["Status"] Width="120px">
                        <Template Context="quote">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(quote.Status)" Text="@quote.Status.ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.TotalAmount) Title=@Localizer["TotalAmount"] TextAlign="TextAlign.Right">
                        <Template Context="item">
                            @item.TotalAmount.ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Quote" Property=@nameof(Quote.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

<style>
    :root {
        .rz-tabview.rz-tabview-top { flex-direction: row !important; }
    }
</style>
