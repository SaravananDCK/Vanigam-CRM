@page "/payments"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseListView<Payment, Payments>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject PaymentApiService PaymentApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Payments"] : Localizer["Payments"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || CustomerId.HasValue) />
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Payment" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Payment" Filterable="false" Sortable="false" Width="120px" Title="@Localizer["Actions"]">
                        <Template Context="payment">
                            <OpenPageCommonComponent T="Payment" OpenObject="@payment" Open="@Open"></OpenPageCommonComponent>
                            <DeletePageCommonComponent T="Payment" UsingObject="@payment" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.Number) Title=@Localizer["Number"] Visible="@(!IsEmbeddedMode)" />
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.PaymentAmount) Title=@Localizer["PaymentAmount"] TextAlign="TextAlign.Right">
                        <Template Context="invoice">
                            @invoice.PaymentAmount.ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.AllocatedAmount) Title=@Localizer["AllocatedAmount"] TextAlign="TextAlign.Right">
                        <Template Context="invoice">
                            @invoice.AllocatedAmount.ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.UnallocatedAmount) Title=@Localizer["UnallocatedAmount"] TextAlign="TextAlign.Right">
                        <Template Context="invoice">
                            @invoice.UnallocatedAmount.ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.Status) Title=@Localizer["Status"] Width="120px">
                        <Template Context="payment">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(payment.Status)" Text="@payment.Status.ToString()" class="rz-p-1" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.PaidAt) Title=@Localizer["PaidAt"]>
                        <Template>
                            @context.PaidAt.ToHumanDateTime()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property="@PropertyExtensions.GetPropertyFullPath((Payment p) => p.Party.Name)" Title=@Localizer["ProviderReference"]>
                        <Template Context="payment">
                            @payment.Party.Name
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Payment" Property=@nameof(Payment.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Guid? CustomerId { get; set; }
    [Parameter] public bool IsEmbeddedMode { get; set; } = false;
    [Parameter] public string? EmbeddedTitle { get; set; }
}