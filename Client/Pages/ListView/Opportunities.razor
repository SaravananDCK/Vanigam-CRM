@page "/opportunities"
@using Vanigam.CRM.Objects.Entities
@inherits Vanigam.CRM.Client.Components.BaseListView<Opportunity, Opportunities>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject OpportunityApiService OpportunityApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Opportunities"] : Localizer["Opportunities"])
                            AddButtonClick=@AddButtonClick 
                            SearchButtonClick=@Search
                            ShowAdd=false>
        <RadioButtons>
            @* Stage Filter Bar using RadzenTabs *@
            <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndexChanged="OnStageTabChange"
                        TabPosition="TabPosition.Top" class="modern-tabs">
                <Tabs>
                    <RadzenTabsItem>
                        <Template>
                            <FilterTabTemplate Text="@Localizer["All"]" Count="@(TotalCount.ToString() ?? "0")" Icon="@FadIcon("fa-list")" Style="@BadgeStyle.Primary" ></FilterTabTemplate>
                        </Template>
                    </RadzenTabsItem>
                    @foreach (OpportunityStage stage in Enum.GetValues<OpportunityStage>())
                    {
                        <RadzenTabsItem>
                            <Template>
                                <FilterTabTemplate Text="@Localizer[stage.GetDisplayDescription().ToString()]" Count="@(GetStageCount(stage).ToString())" Icon="@FadIcon(GetIcon(stage))" Style="@GetStageBadgeStyle(stage)" ></FilterTabTemplate>
                            </Template>
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        </RadioButtons>
    </ListPageTitleComponent>

    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Opportunity" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Opportunity" Filterable="false" Sortable="false" Width="120px" Title="@Localizer["Actions"]">
                        <Template Context="opportunity">
                            <OpenPageCommonComponent T="Opportunity" OpenObject="@opportunity" Open="@Open"></OpenPageCommonComponent>
                            <DeletePageCommonComponent T="Opportunity" UsingObject="@opportunity" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property="Lead.Name" Title=@Localizer["Lead"] Visible="@(!IsEmbeddedMode)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Title) Title=@Localizer["Title"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Description) Title=@Localizer["Description"] Width="200px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.EstimatedValue) Title=@Localizer["EstimatedValue"] TextAlign="TextAlign.Right">
                        <Template Context="opportunity">
                            @(opportunity.EstimatedValue.ToString("C") ?? "-")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Probability) Title=@Localizer["Probability"] Width="100px">
                        <Template Context="opportunity">
                            @(opportunity.Probability)%
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Stage) Title=@Localizer["Stage"]>
                        <Template Context="opportunity">
                            <RadzenBadge BadgeStyle="@Vanigam.CRM.Client.Helpers.BadgeHelper.GetBadgeStyle(opportunity.Stage)" Text="@opportunity.Stage.GetDisplayDescription().ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Source) Title=@Localizer["Source"] Width="120px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.ExpectedCloseDate) Title=@Localizer["ExpectedCloseDate"]>
                        <Template Context="opportunity">
                            @if (opportunity.ExpectedCloseDate.HasValue)
                            {
                                <span class="@(opportunity.ExpectedCloseDate < DateTime.Today ? "text-danger" : opportunity.ExpectedCloseDate <= DateTime.Today.AddDays(3) ? "text-warning" : "")">
                                    @opportunity.ExpectedCloseDate.Value.ToString("MM/dd/yyyy")
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Opportunity" Property=@nameof(Opportunity.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>