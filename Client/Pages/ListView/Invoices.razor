@page "/invoices"
@using Vanigam.CRM.Client.Services
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseListView<Invoice, Invoices>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject InvoiceApiService InvoiceApiService
@inject PdfApiService PdfApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Invoices"] : Localizer["Invoices"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || PartyId.HasValue) />
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Invoice" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Invoice" Filterable="false" Sortable="false" Width="200px" Title="@Localizer["Actions"]">
                        <Template Context="invoice">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <OpenPageCommonComponent T="Invoice" OpenObject="@invoice" Open="@Open"></OpenPageCommonComponent>
                                <DeletePageCommonComponent T="Invoice" UsingObject="@invoice" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="preview" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => PreviewPdf(invoice.Oid))" Title="@Localizer["Preview PDF"]" />
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="download" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => DownloadPdf(invoice.Oid))" Title="@Localizer["Download PDF"]" />
                            </RadzenStack>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property=@nameof(Invoice.VoucherDate) Title=@Localizer["Date"]>
                        <Template>
                            @context.VoucherDate.ToHumanDateTime()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property=@nameof(Invoice.Number) Title=@Localizer["Number"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property="@PropertyExtensions.GetPropertyFullPath((Invoice i) => i.Party.Name)" Title=@Localizer["Customer"] Visible="@(!IsEmbeddedMode)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property="@PropertyExtensions.GetPropertyFullPath((Invoice i) => i.Quote.Number)" Title=@Localizer["Quote"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property=@nameof(Invoice.Status) Title=@Localizer["Status"] Width="120px">
                        <Template Context="invoice">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(invoice.Status)" Text="@invoice.Status.GetDisplayDescription().ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property=@nameof(Invoice.TotalAmount) Title=@Localizer["TotalAmount"] TextAlign="TextAlign.Right">
                        <Template Context="invoice">
                            @invoice.TotalAmount.ToString("C")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Invoice" Property=@nameof(Invoice.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Guid? PartyId { get; set; }
    [Parameter] public bool IsEmbeddedMode { get; set; } = false;
    [Parameter] public string? EmbeddedTitle { get; set; }

    private async Task PreviewPdf(Guid invoiceId)
    {
        await PdfApiService.PreviewInvoicePdfAsync(invoiceId);
    }

    private async Task DownloadPdf(Guid invoiceId)
    {
        await PdfApiService.DownloadInvoicePdfAsync(invoiceId);
    }
}