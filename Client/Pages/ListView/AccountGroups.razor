@page "/accountgroups"
@using Vanigam.CRM.Client.Services
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseListView<AccountGroup, AccountGroups>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject AccountGroupApiService AccountGroupApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@Localizer["AccountGroups"] AddButtonClick=@AddButtonClick SearchButtonClick=@Search />
    <RadzenRow>
        <RadzenColumn SizeMD=12>
            <RadzenCard>
                @if (TreeDataSource != null && TreeDataSource.Any())
                {
                    <RadzenTree Data="@TreeDataSource"
                                Style="width: 100%; height: 100%; overflow: auto;"
                                @bind-Value="@SelectedItem">
                        <RadzenTreeLevel TextProperty="Name"
                                         ChildrenProperty="ChildGroups"
                                        HasChildren="@((accountGroup) => ((AccountGroup)accountGroup).ChildGroups?.Any() == true)"
                                        Expanded="@((accountGroup) => ShouldExpand((AccountGroup)accountGroup))">
                            <Template>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Style="width: 100%;">
                                    <RadzenIcon Icon="folder" Style="color: var(--rz-info);" />
                                    <RadzenText TextStyle="TextStyle.Body1">
                                        <strong>@context.Text</strong>
                                    </RadzenText>
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@((context.Value as AccountGroup)?.Code)" class="rz-ml-2" />
                                    <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle((context.Value as AccountGroup)?.Nature ?? AccountNature.Asset)" Text="@((context.Value as AccountGroup)?.Nature.ToString())" class="rz-ml-1" />
                                    @if ((context.Value as AccountGroup)?.IsActive == false)
                                    {
                                        <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyleForBoolean(false)" Text=@Localizer["Inactive"] class="rz-ml-1" />
                                    }
                                    <div style="margin-left: auto;">
                                        <RadzenButton Icon="edit"
                                                     ButtonStyle="ButtonStyle.Light"
                                                     Size="ButtonSize.Small"
                                                     Click="@(() => OpenEditDialog((AccountGroup)context.Value))"
                                                     class="rz-mr-1" />
                                        @* <RadzenButton Icon="delete"
                                                     ButtonStyle="ButtonStyle.Danger"
                                                     Size="ButtonSize.Small"
                                                     Click="@(() => DeleteAccountGroup((AccountGroup)context.Value))" /> *@
                                    </div>
                                </RadzenStack>
                            </Template>
                        </RadzenTreeLevel>
                    </RadzenTree>
                }
                else
                {
                    <NoRecordComponent ShowAddButton="false" />
                }

                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3">
                    @Localizer["Count"]: <b>@TotalCount</b>
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
