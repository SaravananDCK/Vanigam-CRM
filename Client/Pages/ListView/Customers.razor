@page "/customers"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@inherits Vanigam.CRM.Client.Components.BaseListView<Customer, Customers>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject CustomerApiService CustomerApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@Localizer["Customers"] AddButtonClick=@AddButtonClick SearchButtonClick=@Search />
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Customer" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" RowSelect="@OnRowSelect" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Customer" Filterable="false" Sortable="false" Width="120px" Title="@Localizer["Actions"]">
                        <Template Context="customer">
                            <OpenPageCommonComponent T="Customer" OpenObject="@customer" Open="@Open"></OpenPageCommonComponent>
                            <DeletePageCommonComponent T="Customer" UsingObject="@customer" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Code) Title=@Localizer["Code"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Name) Title=@Localizer["Name"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Type) Title=@Localizer["Type"] Width="100px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Industry) Title=@Localizer["Industry"] Width="150px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.City) Title=@Localizer["City"] Width="120px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.State) Title=@Localizer["State"] Width="100px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Email) Title=@Localizer["Email"] Width="200px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Phone) Title=@Localizer["Phone"] Width="150px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.AnnualRevenue) Title=@Localizer["AnnualRevenue"] Width="130px">
                        <Template Context="customer">
                            @if (customer.AnnualRevenue.HasValue)
                            {
                                @(customer.AnnualRevenue.Value.ToString("C0"))
                            }
                            else
                            {
                                @("-")
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property="@PropertyExtensions.GetPropertyFullPath((Customer i) => i.Opportunity.Title)" Title=@Localizer["Opportunity"] />
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Status) Title=@Localizer["Status"] Width="120px">
                        <Template Context="customer">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(customer.Status)" Text="@customer.Status.ToString()" class="rz-p-1" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Rating) Title=@Localizer["Rating"] Width="80px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Customer" Property=@nameof(Customer.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>

    @* Nested Related Data Section *@
    @if (SelectedCustomer != null)
    {
        <RadzenRow class="mt-4">
            <RadzenColumn SizeMD=12>
                <RadzenCard>
                    <RadzenTabs @bind-SelectedIndex="SelectedTabIndex" RenderMode="TabRenderMode.Client">
                        <RadzenTabsItem Text="@Localizer["Contacts"]">
                            <Contacts CustomerId="@SelectedCustomer.Oid"
                                      IsEmbeddedMode="true"
                                      EmbeddedTitle="@Localizer["CustomerContacts"]" />
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@Localizer["Jobs"]">
                            <Jobs CustomerId="@SelectedCustomer.Oid"
                                  IsEmbeddedMode="true"
                                  EmbeddedTitle="@Localizer["CustomerJobs"]" />
                        </RadzenTabsItem>
                    </RadzenTabs>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</RadzenStack>