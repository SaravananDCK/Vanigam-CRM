@page "/activities"
@using Vanigam.CRM.Objects.Entities
@using NodaTime.Extensions
@inherits Vanigam.CRM.Client.Components.BaseListView<Activity, Activities>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject ActivityApiService ActivityApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Activities"] : Localizer["Activities"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || LeadId.HasValue || OpportunityId.HasValue) />
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Activity" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Activity" Filterable="false" Sortable="false" Width="120px" Title="@Localizer["Actions"]">
                        <Template Context="activity">
                            <OpenPageCommonComponent T="Activity" OpenObject="@activity" Open="@Open"></OpenPageCommonComponent>
                            <DeletePageCommonComponent T="Activity" UsingObject="@activity" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Subject) Title=@Localizer["Subject"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Type) Title=@Localizer["Type"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Status) Title=@Localizer["Status"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.ActivityDate) Title=@Localizer["ActivityDate"]>
                        <Template Context="activity">
                            @activity.ActivityDate.ToDateTimeUtc().ToString("yyyy-MM-dd HH:mm")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property="Lead.Name" Title=@Localizer["Lead"] Visible="@(!IsEmbeddedMode && LeadId == null)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property="Opportunity.Title" Title=@Localizer["Opportunity"] Visible="@(!IsEmbeddedMode && OpportunityId == null)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Description) Title=@Localizer["Description"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public Guid? LeadId { get; set; }
    [Parameter] public Guid? OpportunityId { get; set; }
    [Parameter] public bool IsEmbeddedMode { get; set; } = false;
    [Parameter] public string? EmbeddedTitle { get; set; }
}