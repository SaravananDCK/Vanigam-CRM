@page "/activities"
@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Helpers
@using NodaTime.Extensions
@inherits Vanigam.CRM.Client.Components.BaseListView<Activity, Activities>
@attribute [Authorize(Policy = Vanigam.CRM.Objects.ApplicationPolicy.IsAdministrator)]
@inject ActivityApiService ActivityApiService

<RadzenStack>
    <ListPageTitleComponent TitleText=@(IsEmbeddedMode ? EmbeddedTitle ?? Localizer["Activities"] : Localizer["Activities"])
                            AddButtonClick=@AddButtonClick
                            SearchButtonClick=@Search
                            ShowAdd=@(!IsEmbeddedMode || LeadId.HasValue || OpportunityId.HasValue)>
        <RadioButtons>
            @* Status Filter Bar using RadzenTabs with FilterTabTemplate *@
            @if (!IsEmbeddedMode)
            {
                <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndexChanged="OnStatusTabChange"
                            TabPosition="TabPosition.Top" class="modern-tabs">
                    <Tabs>
                        <RadzenTabsItem>
                            <Template>
                                <FilterTabTemplate Text="@Localizer["All"]"
                                                 Count="@(TotalCount.ToString() ?? "0")"
                                                 Icon="@FadIcon("fa-list")"
                                                 Style="@BadgeStyle.Primary" />
                            </Template>
                        </RadzenTabsItem>
                        @foreach (ActivityStatus status in Enum.GetValues<ActivityStatus>())
                        {
                            <RadzenTabsItem>
                                <Template>
                                    <FilterTabTemplate Text="@Localizer[status.ToString()]"
                                                     Count="@(GetStatusCount(status).ToString())"
                                                     Icon="@FadIcon(GetIcon(status))"
                                                     Style="@GetStatusBadgeStyle(status)" />
                                </Template>
                            </RadzenTabsItem>
                        }
                    </Tabs>
                </RadzenTabs>
            }
        </RadioButtons>
    </ListPageTitleComponent>
    <RadzenRow>
        <RadzenColumn SizeMD=12 class="datagrid-container-standard">
            <VanigamAccountingDataGrid @ref="GridControl" AllowColumnPicking="@AllowColPick" Data="@DataSource" Count=Count TItem="Activity" VanigamAccountingLoadData=@GridLoadData RowDoubleClick="@EditRow" @bind-Settings="@Settings" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" LoadSettings="@LoadSettings">
                <EmptyTemplate>
                    <NoRecordComponent ShowAddButton="false" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="Activity" Filterable="false" Sortable="false" Width="120px" Title="@Localizer["Actions"]">
                        <Template Context="activity">
                            <OpenPageCommonComponent T="Activity" OpenObject="@activity" Open="@Open"></OpenPageCommonComponent>
                            <DeletePageCommonComponent T="Activity" UsingObject="@activity" GridDeleteButtonClick="@GridDeleteButtonClick"></DeletePageCommonComponent>
                        </Template>
                        <FooterTemplate>@Localizer["Count"]: <b>@Count</b></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Subject) Title=@Localizer["Subject"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Type) Title=@Localizer["Type"] Width="150px">
                        <Template Context="activity">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(activity.Type)" Text="@activity.Type.GetDisplayDescription().ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Status) Title=@Localizer["Status"] Width="120px">
                        <Template Context="activity">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(activity.Status)" Text="@activity.Status.GetDisplayDescription().ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.ActivityDate) Title=@Localizer["ActivityDate"]>
                        <Template Context="activity">
                            @activity.ActivityDate.ToDateTimeUtc().ToString("yyyy-MM-dd HH:mm")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Duration) Title=@Localizer["Duration"] Width="100px">
                        <Template Context="activity">
                            @(activity.Duration?.ToString() ?? "-") @if(activity.Duration.HasValue) { <text>min</text> }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Priority) Title=@Localizer["Priority"] Width="120px">
                        <Template Context="activity">
                            <RadzenBadge BadgeStyle="@BadgeHelper.GetBadgeStyle(activity.Priority)" Text="@activity.Priority.ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property="@PropertyExtensions.GetPropertyFullPath((Activity i) => i.Lead.Name)" Title=@Localizer["Lead"] Visible="@(!IsEmbeddedMode && LeadId == null)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property="@PropertyExtensions.GetPropertyFullPath((Activity i) => i.Opportunity.Title)" Title=@Localizer["Opportunity"] Visible="@(!IsEmbeddedMode && OpportunityId == null)">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Description) Title=@Localizer["Description"]>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Outcome) Title=@Localizer["Outcome"] Width="150px">
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Activity" Property=@nameof(Activity.Oid) Title=@Localizer["Oid"] Visible="false">
                    </RadzenDataGridColumn>
                </Columns>
            </VanigamAccountingDataGrid>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
