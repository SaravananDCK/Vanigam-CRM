@using Microsoft.Extensions.Localization
@using Vanigam.CRM.Objects.DTOs
@using Vanigam.CRM.Objects.Entities
@inject IStringLocalizer<EditableInvoiceItems> Localizer
@inject NotificationService NotificationService
@inject ItemApiService ItemApiService

<RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@Localizer["InvoiceItems"]</RadzenText>

        @* Add New Item Button *@
        <RadzenButton Text="@Localizer["AddItem"]"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.Small"
                      Click="@AddNewItem" />
    </RadzenStack>
    @* Items List *@
    @if (Items?.Any() == true)
    {
        <RadzenDataGrid @ref="itemsGrid" Data="@Items.Where(i => !i.IsDeleted)" TItem="InvoiceItemDTO"
                        AllowFiltering="false" AllowPaging="false" AllowSorting="false"
                        EditMode="Radzen.DataGridEditMode.Single" RowUpdate="@OnRowUpdate"
                        class="rz-mt-3">
            <Columns>
                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="ItemName" Title="@Localizer["Item"]" Width="200px">
                    <Template Context="item">
                        @(item.InventoryItemName ?? "-")
                    </Template>
                    <EditTemplate Context="item">
                        <ItemDropDownDataGrid @bind-Value="item.InventoryItemId"
                                              Change="@(async (object value) => { await OnInventoryItemChanged(item, value); })"
                                              class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="Quantity" Title="@Localizer["Quantity"]" Width="120px" TextAlign="TextAlign.Right">
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="double" @bind-Value="item.Quantity"
                                       Min="1" TextAlign="TextAlign.Right"
                                       Change="@(async (double value) => { item.Quantity = value; await CalculateItemAmount(item); })"
                                       class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="UnitPrice" Title="@Localizer["UnitPrice"]" Width="150px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        @item.UnitPrice.ToString("C")
                    </Template>
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="decimal" @bind-Value="item.UnitPrice"
                                       Format="C"
                                       Min="0" TextAlign="TextAlign.Right"
                                       Change="@(async (decimal value) => { item.UnitPrice = value; await CalculateItemAmount(item); })"
                                       class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property=@nameof(InvoiceItemDTO.DiscountAmount) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Discount"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @item.DiscountAmount.ToString("C")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property=@nameof(InvoiceItemDTO.TaxAmount) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Tax"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @((item.TaxAmount ?? 0).ToString("C"))
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property="Total" Title="@Localizer["Total"]" Width="150px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Total"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @item.Total.ToString("C")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="InvoiceItemDTO" Property=@nameof(InvoiceItemDTO.TotalIncTax) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Total Inc.Tax"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @item.TotalIncTax.ToString("C")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="InvoiceItemDTO" Width="150px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Actions"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => EditRow(item))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => DeleteItem(item))"
                                      class="rz-ml-2" />
                    </Template>
                    <EditTemplate Context="item">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => SaveRow(item))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => CancelEdit(item))"
                                      class="rz-ml-2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @* Totals Display *@
        <RadzenCard class="rz-my-4">
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenRow Gap="1rem" RowGap="1rem">
                            <RadzenColumn Size="2">
                                <div style="margin-top: 4rem; margin-right: 1rem">
                                    <div class="read-only-field rz-mb-3">
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Tot.Items"]:</strong></RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width:60px" TextAlign="TextAlign.Right">@(Items.Count())</RadzenText>
                                        </RadzenStack>
                                    </div>
                                    <div class="read-only-field rz-mb-3">
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Tot.Qty"]:</strong></RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width:60px" TextAlign="TextAlign.Right">@(Items.Sum(i => i.Quantity))</RadzenText>
                                        </RadzenStack>
                                    </div>
                                </div>
                            </RadzenColumn>

                            <RadzenColumn Size="4">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenRadioButtonList TValue="DiscountType"
                                                               Value="Invoice.DiscountType"
                                                               ValueChanged="OnDiscountTypeChange">
                                            <Items>
                                                <RadzenRadioButtonListItem Text=@Localizer[$"{DiscountType.Percentage}"] Value="DiscountType.Percentage" />
                                                <RadzenRadioButtonListItem Text=@Localizer[$"{DiscountType.Amount}"] Value="DiscountType.Amount" />
                                            </Items>
                                        </RadzenRadioButtonList>
                                        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Success"
                                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                                      Click="@(() => CalculateDiscount(true))" />
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Discount %"]:</strong></RadzenText>

                                        <RadzenNumeric TValue="decimal"
                                                       @bind-Value="Invoice.DiscountPercent"
                                                       Style="@(Invoice.DiscountType == DiscountType.Amount ? "width: 150px; background-color: var(--rz-base-100)" : "width: 150px;")"
                                                       ReadOnly="Invoice.DiscountType == DiscountType.Amount"
                                                       Format="N2" TextAlign="TextAlign.Right" Min="0" MaxLength="5"
                                                       Change="@(async (decimal value) => { Invoice.DiscountPercent = value; await CalculateDiscount(true); await NotifyChanges(); })"
                                                       class="w-100 field-value" />
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Discount Amt"]:</strong></RadzenText>
                                        <RadzenNumeric TValue="decimal"
                                                       @bind-Value="Invoice.DiscountAmount"
                                                       Style="@(Invoice.DiscountType == DiscountType.Percentage ? "width: 150px; background-color: var(--rz-base-100)":"width: 150px;")"
                                                       ReadOnly="Invoice.DiscountType == DiscountType.Percentage"
                                                       Format="C" TextAlign="TextAlign.Right" ShowUpDown="false" Min="0"
                                                       Change="@(async (decimal value) => { Invoice.DiscountAmount = value; await CalculateDiscount(true); await NotifyChanges(); })"
                                                       class="w-100 field-value" />
                                    </RadzenStack>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="3">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["CGST"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 120px" TextAlign="TextAlign.Right">@(Invoice.CGSTAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["SGST"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 120px" TextAlign="TextAlign.Right">@(Invoice.SGSTAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["IGST"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 120px" TextAlign="TextAlign.Right">@(Invoice.IGSTAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Cess"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 120px" TextAlign="TextAlign.Right">@(Invoice.CessAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="3">
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Sub Total"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 150px" TextAlign="TextAlign.Right">@(Invoice.SubTotal.ToString("C"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Tax"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 150px" TextAlign="TextAlign.Right">@(Invoice.TaxAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label" Style="color: var(--rz-danger);"><strong>@Localizer["Discount"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="color: var(--rz-danger); width: 150px" TextAlign="TextAlign.Right">@(Invoice.DiscountAmount.ToString("C2"))</RadzenText>
                                    </RadzenStack>
                                </div>
                                <div class="read-only-field rz-mb-3">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.Center">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="field-label"><strong>@Localizer["Grand Total"]:</strong></RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.Span" class="field-value" Style="width: 150px" TextAlign="TextAlign.Right"><strong>@(Invoice.TotalAmount.ToString("C2"))</strong></RadzenText>
                                    </RadzenStack>
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
    }
    else
    {
        <RadzenCard class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
                @Localizer["NoItems"]
            </RadzenText>
        </RadzenCard>
    }
</RadzenStack>
