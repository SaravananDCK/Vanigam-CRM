@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Services
@using Microsoft.Extensions.Localization
@inherits CoreView
@inject LeadApiService ConversionService
@inject IStringLocalizer<ConvertOpportunityToCustomerDialog> Localizer

<RadzenStack>
    <RadzenTemplateForm @ref="form" TItem="CustomerConversionModel" Data="@model" Submit="@OnConvert">
        @if (Opportunity != null)
        {
            <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Info" class="rz-mb-4">
                @Localizer["ConvertingOpportunity"]: <strong>@Opportunity.Title</strong>
            </RadzenAlert>


            <RadzenStack Gap="1rem">
                <VanigamAccountingFormField Text="@Localizer["CustomerName"]">
                    <ChildContent>
                        <VanigamAccountingTextBox @bind-Value="@model.CustomerName" Name="txt_CustomerName" Placeholder="@Localizer["EnterCustomerName"]" />
                        <RadzenRequiredValidator Component="txt_CustomerName" Text="@Localizer["CustomerNameRequired"]" />
                    </ChildContent>
                </VanigamAccountingFormField>

                <VanigamAccountingFormField Text="@Localizer["CustomerType"]">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="@model.CustomerType" Data="@customerTypes" Name="dd_CustomerType" class="w-100" />
                    </ChildContent>
                </VanigamAccountingFormField>
            </RadzenStack>

            <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Warning" class="rz-my-4">
                @Localizer["ConversionWillCloseOpportunity"]
            </RadzenAlert>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-4" Gap="0.5rem">
                <RadzenButton Text="@Localizer["Cancel"]" Click="@Cancel" ButtonStyle="ButtonStyle.Light" />
            </RadzenStack>
        }
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-4" Gap="0.5rem">
            <RadzenButton Text="@Localizer["Convert"]" ButtonType="ButtonType.Submit" IsBusy="@isBusy"
                          Icon="person_add" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="@Localizer["Cancel"]" Click="@Cancel" ButtonStyle="ButtonStyle.Light" />
        </RadzenStack>
    </RadzenTemplateForm>
    
    
</RadzenStack>