@using Vanigam.CRM.Objects.Entities
@using Vanigam.CRM.Client.Services
@using Microsoft.Extensions.Localization
@using Vanigam.CRM.Helpers
@inject LeadApiService ConversionService
@inherits CoreView
@inject IStringLocalizer<ConvertLeadToOpportunityDialog> Localizer

<RadzenStack>
    @if (Lead != null)
    {
        <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Info" class="rz-mb-4">
            @Localizer["ConvertingLead"]: <strong>@Lead.Name</strong>
        </RadzenAlert>
    }

    <RadzenTemplateForm @ref="form" TItem="ConversionModel" Data="@model" Submit="@OnSubmit">
        <RadzenStack Gap="1rem">
            <VanigamAccountingFormField Text="@Localizer["OpportunityTitle"]">
                <ChildContent>
                    <VanigamAccountingTextBox @bind-Value="@model.Title" Name="txt_Title" Placeholder="@Localizer["EnterOpportunityTitle"]" />
                    <RadzenRequiredValidator Component="txt_Title" Text="@Localizer["TitleRequired"]" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text="@Localizer["EstimatedValue"]">
                <ChildContent>
                    <RadzenNumeric @bind-Value="@model.EstimatedValue" Name="num_Value" class="w-100" Format="C" Min="0" />
                    <RadzenRequiredValidator Component="num_Value" Text="@Localizer["ValueRequired"]" />
                </ChildContent>
            </VanigamAccountingFormField>

            <VanigamAccountingFormField Text="@Localizer["ExpectedCloseDate"]">
                <ChildContent>
                    <RadzenDatePicker @bind-Value="@model.ExpectedCloseDate" Name="date_CloseDate" class="w-100" DateFormat="yyyy-MM-dd" />
                    <RadzenRequiredValidator Component="date_CloseDate" Text="@Localizer["CloseDateRequired"]" />
                </ChildContent>
            </VanigamAccountingFormField>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-4" Gap="0.5rem">
            <RadzenButton Text="@Localizer["Convert"]" ButtonType="ButtonType.Submit" IsBusy="@isBusy"
                         Icon="transform" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="@Localizer["Cancel"]" Click="@Cancel" ButtonStyle="ButtonStyle.Light" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>