@using Microsoft.Extensions.Localization
@using Vanigam.CRM.Objects.DTOs
@using Vanigam.CRM.Objects.Entities
@inject IStringLocalizer<EditableQuoteItems> Localizer
@inject ItemApiService ItemApiService
@inject NotificationService NotificationService

<RadzenStack>
    @* Add New Item Button *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@Localizer["Items"]</RadzenText>
        <RadzenButton Text="@Localizer["AddItem"]"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.Small"
                      Click="@AddNewItem"/>
    </RadzenStack>

    @* Items List *@
    @if (Items?.Any() == true)
    {
        <RadzenDataGrid @ref="itemsGrid" Data="@Items.Where(i => !i.IsDeleted)" TItem="QuoteItemDTO"
                       AllowFiltering="false" AllowPaging="false" AllowSorting="false"
                       EditMode="Radzen.DataGridEditMode.Single" RowUpdate="@OnRowUpdate"
                       class="rz-mt-3">
            <Columns>
                <RadzenDataGridColumn TItem="QuoteItemDTO" Property=@nameof(QuoteItemDTO.InventoryItemName) Title="@Localizer["Item"]" Width="200px">
                    <EditTemplate Context="item">
                        <ProductDropDownDataGrid @bind-Value="item.InventoryItemId"
                                                 TextProperty="Name"
                                                 ValueProperty="Oid"
                                                 Placeholder="@Localizer["SelectItem"]"
                                                 Change="@(async (object value) => { item.InventoryItemId = (Guid?)value; await OnInventoryItemChanged(value as Guid?,item); })"
                                                 class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="QuoteItemDTO" Property=@nameof(QuoteItemDTO.Quantity) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Quantity"]</div>
                    </HeaderTemplate>
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="double" @bind-Value="item.Quantity"
                                       Min="1"
                                       Change="@(async (double value) => { item.Quantity = value; CalculateTotal(item); await NotifyChanges(); })"
                                       class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="QuoteItemDTO" Property=@nameof(QuoteItemDTO.UnitPrice) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["UnitPrice"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @item.UnitPrice.ToString("C")
                    </Template>
                    <EditTemplate Context="item">
                        <RadzenNumeric TValue="decimal" @bind-Value="item.UnitPrice"
                                       Format="C"
                                       Change="@(async (decimal value) => { item.UnitPrice = value; CalculateTotal(item); await NotifyChanges(); })"
                                       class="w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="QuoteItemDTO" Property=@nameof(QuoteItemDTO.TaxAmount) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["TaxAmount"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @((item.TaxAmount ?? 0).ToString("C"))
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="QuoteItemDTO" Property=@nameof(QuoteItemDTO.Total) Width="120px" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Total"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        @item.Total.ToString("C")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="QuoteItemDTO" Width="150px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right">
                    <HeaderTemplate>
                        <div style="padding-right: 20px;">@Localizer["Actions"]</div>
                    </HeaderTemplate>
                    <Template Context="item">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => EditRow(item))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => DeleteItem(item))"
                                      class="rz-ml-2" />
                    </Template>
                    <EditTemplate Context="item">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => SaveRow(item))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Flat" Size="ButtonSize.Small"
                                      Click="@(() => CancelEdit(item))"
                                      class="rz-ml-2" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @* Totals Display *@
        <RadzenCard class="rz-mt-3">
            <RadzenRow>
                <RadzenColumn Size="8" />
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End">
                        <RadzenText TextStyle="TextStyle.H6">@Localizer["Discount"]:</RadzenText>
                        <RadzenText TextStyle="TextStyle.H6">@DiscountAmt.ToString("C")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="8" />
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End">
                        <RadzenText TextStyle="TextStyle.H6">@Localizer["TaxAmount"]:</RadzenText>
                        <RadzenText TextStyle="TextStyle.H6">@TaxAmount.ToString("C")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>

                <RadzenColumn Size="8" />
                <RadzenColumn Size="4">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End">
                        <RadzenText TextStyle="TextStyle.H6">@Localizer["TotalAmount"]:</RadzenText>
                        <RadzenText TextStyle="TextStyle.H6">@TotalAmount.ToString("C")</RadzenText>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
    }
    else
    {
        <RadzenCard class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Body1" class="rz-color-secondary">
                @Localizer["No Items"]
            </RadzenText>
        </RadzenCard>
    }
</RadzenStack>